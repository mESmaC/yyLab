@@ -0,0 +1,189 @@
+"""MLA head alignment keeps original attention, gradients and cache semantics."""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+import torch
+from torch.nn import functional as F
+
+import spalmer.attention.mla as mla_module
+from spalmer.attention.mla import MLAConfig, MLATokenMixer, _pad_sdpa_heads
+
+
+def _config(key_width=12, value_width=12):
+    return MLAConfig(
+        hidden_size=24, num_heads=2, head_k_dim=key_width, head_v_dim=value_width,
+        q_latent_dim=12, kv_latent_dim=8,
+    )
+
+
+def _operands(key_width, value_width, query_length, cache_length, *, dtype=torch.float64):
+    generator = torch.Generator().manual_seed(179)
+    shapes = (
+        (2, 2, query_length, key_width),
+        (2, 2, query_length + cache_length, key_width),
+        (2, 2, query_length + cache_length, value_width),
+    )
+    return tuple(torch.randn(shape, generator=generator, dtype=dtype) for shape in shapes)
+
+
+def _literal_attention(q, k, v, cache_length):
+    scores = (q @ k.transpose(-2, -1)) * (q.shape[-1] ** -0.5)
+    # Query position i can see all cached keys and new keys through position i.
+    causal = torch.arange(k.shape[-2], device=q.device)[None, :] <= (
+        cache_length + torch.arange(q.shape[-2], device=q.device)[:, None]
+    )
+    return scores.masked_fill(~causal, -torch.inf).softmax(-1) @ v
+
+
+@pytest.mark.parametrize("key_width,value_width", [(12, 12), (7, 9), (8, 11), (12, 16)])
+@pytest.mark.parametrize("query_length,cache_length", [(5, 0), (3, 4), (1, 6)])
+def test_fp64_alignment_matches_literal_attention_and_gradients(
+    monkeypatch, key_width, value_width, query_length, cache_length
+):
+    # Exercise production prefill/chunk/step control flow with an FP64 oracle;
+    # only the device/dtype dispatch predicate is overridden on CPU.
+    monkeypatch.setattr(mla_module, "_needs_head_alignment", lambda *args: True)
+    inputs = _operands(key_width, value_width, query_length, cache_length)
+    actual_inputs = [x.clone().requires_grad_() for x in inputs]
+    expected_inputs = [x.clone().requires_grad_() for x in inputs]
+    mixer = MLATokenMixer(_config(key_width, value_width)).double()
+    actual = mixer._attend(*actual_inputs, cache_len=cache_length)
+    expected = _literal_attention(*expected_inputs, cache_length)
+    torch.testing.assert_close(actual, expected, rtol=1e-12, atol=1e-12)
+    grad = torch.linspace(-1, 1, actual.numel(), dtype=actual.dtype).reshape_as(actual)
+    actual.backward(grad)
+    expected.backward(grad)
+    for a, b in zip(actual_inputs, expected_inputs, strict=True):
+        torch.testing.assert_close(a.grad, b.grad, rtol=1e-11, atol=1e-12)
+
+
+def test_padding_retains_values_and_original_key_scale():
+    q, k, v = _operands(12, 5, 3, 0)
+    padded_q, padded_k, padded_v, scale = _pad_sdpa_heads(q, k, v)
+    assert padded_q.shape[-1] == padded_k.shape[-1] == 16
+    assert padded_v.shape[-1] == 8
+    assert scale == 12 ** -0.5
+    assert scale != 16 ** -0.5
+    for original, padded in zip((q, k, v), (padded_q, padded_k, padded_v), strict=True):
+        torch.testing.assert_close(padded[..., :original.shape[-1]], original, rtol=0, atol=0)
+        assert torch.count_nonzero(padded[..., original.shape[-1]:]) == 0
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.float64, torch.bfloat16])
+def test_cpu_path_passes_original_operands_without_scale_override(monkeypatch, dtype):
+    inputs = _operands(12, 12, 3, 0, dtype=dtype)
+    returned = torch.zeros_like(inputs[0])
+
+    def capture(q, k, v, **kwargs):
+        assert all(a is b for a, b in zip((q, k, v), inputs, strict=True))
+        assert kwargs == {"is_causal": True}
+        return returned
+
+    monkeypatch.setattr(mla_module.F, "scaled_dot_product_attention", capture)
+    result = MLATokenMixer(_config())._attend(*inputs, cache_len=0)
+    assert result is returned
+
+
+def test_aligned_helper_preserves_operand_identity():
+    inputs = _operands(16, 8, 3, 0)
+    result = _pad_sdpa_heads(*inputs)
+    assert all(a is b for a, b in zip(inputs, result[:3], strict=True))
+
+
+def test_aligned_full_chunk_and_step_keep_checkpoint_and_cache_schema(monkeypatch):
+    monkeypatch.setattr(mla_module, "_needs_head_alignment", lambda *args: True)
+    torch.manual_seed(181)
+    mixer = MLATokenMixer(_config(12, 9)).double().eval()
+    before = {name: tensor.clone() for name, tensor in mixer.state_dict().items()}
+    x = torch.randn(2, 9, 24, dtype=torch.float64)
+    with torch.no_grad():
+        full, full_state = mixer(x)
+        _, warm = mixer(x[:, :4])
+        chunk, chunk_state = mixer(x[:, 4:], warm)
+        state = warm
+        outputs = []
+        for t in range(4, x.shape[1]):
+            out, state = mixer.step(x[:, t:t + 1], state)
+            outputs.append(out)
+    torch.testing.assert_close(chunk, full[:, 4:], rtol=1e-11, atol=1e-12)
+    torch.testing.assert_close(torch.cat(outputs, 1), chunk, rtol=1e-11, atol=1e-12)
+    for actual in (chunk_state, state):
+        assert actual.latent_kv.shape == (2, 9, 8)
+        # Different GEMM batch shapes in full/chunk/step projection can differ
+        # in the final FP64 bit; the padding path never touches these latents.
+        torch.testing.assert_close(actual.latent_kv, full_state.latent_kv, rtol=1e-14, atol=1e-14)
+    assert set(mixer.state_dict()) == set(before)
+    for name, tensor in mixer.state_dict().items():
+        torch.testing.assert_close(tensor, before[name], rtol=0, atol=0)
+
+
+def _require_cuda():
+    if os.environ.get("SPALMER_TEST_CUDA") != "1":
+        pytest.skip("CUDA checks require SPALMER_TEST_CUDA=1")
+    if not torch.cuda.is_available():
+        pytest.skip("CUDA is unavailable")
+
+
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float16])
+@pytest.mark.parametrize("query_length,cache_length", [(129, 0), (17, 31), (1, 63)])
+@pytest.mark.parametrize("backend", ["auto", "efficient"])
+def test_opt_in_cuda_automatic_attention_forward_backward_against_math(
+    dtype, query_length, cache_length, backend
+):
+    _require_cuda()
+    from torch.nn.attention import SDPBackend, sdpa_kernel
+
+    inputs = _operands(12, 12, query_length, cache_length, dtype=dtype)
+    actual_inputs = [x.to("cuda").requires_grad_() for x in inputs]
+    expected_inputs = [x.to("cuda").requires_grad_() for x in inputs]
+    mixer = MLATokenMixer(_config()).to(device="cuda", dtype=dtype)
+    assert mla_module._needs_head_alignment(*actual_inputs)
+    if query_length == 1:
+        kwargs = {}
+    elif cache_length == 0:
+        kwargs = {"is_causal": True}
+    else:
+        mask = torch.arange(cache_length + query_length, device="cuda")[None, :] <= (
+            cache_length + torch.arange(query_length, device="cuda")[:, None]
+        )
+        kwargs = {"attn_mask": mask}
+    if backend == "efficient":
+        padded = _pad_sdpa_heads(*actual_inputs)
+        params = torch.backends.cuda.SDPAParams(
+            *padded[:3], kwargs.get("attn_mask"), 0.0, kwargs.get("is_causal", False), False
+        )
+        if not torch.backends.cuda.can_use_efficient_attention(params):
+            pytest.skip("this CUDA build/device cannot run efficient attention for this shape")
+        with sdpa_kernel(SDPBackend.EFFICIENT_ATTENTION):
+            actual = mixer._attend(*actual_inputs, cache_len=cache_length)
+    else:
+        actual = mixer._attend(*actual_inputs, cache_len=cache_length)
+    with sdpa_kernel(SDPBackend.MATH):
+        expected = F.scaled_dot_product_attention(*expected_inputs, **kwargs)
+    # Readiness on SM120 measured at most .015625 output / .03125 dX error
+    # for larger BF16 inputs. Use both elementwise and relative-L2 bounds so
+    # near-zero outputs do not hide a broad numerical shift.
+    rtol, atol, relative_limit = (0.04, 0.02, 0.025) if dtype == torch.bfloat16 else (
+        0.008, 0.004, 0.006
+    )
+    torch.testing.assert_close(actual, expected, rtol=rtol, atol=atol)
+    grad = torch.linspace(-1, 1, actual.numel(), device="cuda").reshape_as(actual).to(dtype)
+    actual.backward(grad)
+    expected.backward(grad)
+    for a, b in [(actual, expected), *[(a.grad, b.grad) for a, b in zip(
+        actual_inputs, expected_inputs, strict=True
+    )]]:
+        assert torch.isfinite(a).all()
+        torch.testing.assert_close(a, b, rtol=rtol, atol=2 * atol)
+        relative = (a.float() - b.float()).norm() / b.float().norm().clamp_min(1e-12)
+        assert relative < relative_limit, relative
+
+
+def test_opt_in_cuda_aligned_and_fp32_dispatch_are_unchanged():
+    _require_cuda()
+    for key, value, dtype in [(16, 8, torch.bfloat16), (12, 12, torch.float32)]:
+        inputs = [x.to("cuda") for x in _operands(key, value, 3, 0, dtype=dtype)]
+        assert not mla_module._needs_head_alignment(*inputs)
