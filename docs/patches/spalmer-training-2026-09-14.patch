+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+
+from spalmer.config import RecurrenceConfig
+from spalmer.training.depth_evaluation import measure_depths
+
+
+class Probe(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.anchor = nn.Parameter(torch.zeros(()))
+        self.execution_device = torch.device("cpu")
+        self.config = SimpleNamespace(recurrence=RecurrenceConfig(1, 2, 1), d_model=3)
+        self.calls = []
+
+    def forward(self, ids, *, recurrence_steps, latent_init, use_cache):
+        assert not self.training and not torch.is_grad_enabled() and use_cache is False
+        self.calls.append((ids.clone(), recurrence_steps, latent_init.clone()))
+        logits = torch.zeros((*ids.shape, 4), dtype=torch.bfloat16)
+        logits[..., 0] = recurrence_steps
+        return SimpleNamespace(
+            logits=logits,
+            latent_deltas=torch.tensor([0.5]),
+            token_mixer_states=(),
+            channel_mixer_states=(),
+        )
+
+
+def test_depth_sweep_pairs_latents_and_scores_only_next_tokens_in_fp32():
+    model = Probe().train()
+    ids = torch.tensor([[0, 1, 2], [1, 2, 3]])
+    records = measure_depths(model, ids, depths=[1, 2], seeds=[3, 9], batch_size=2, warmup=False)
+    assert model.training and model.anchor.grad is None
+    assert len(records) == 4
+    for record in records:
+        depth = record["depth"]
+        expected = 2 * torch.logsumexp(torch.tensor([float(depth), 0, 0, 0]), 0).item()
+        assert record["nll_sums"] == pytest.approx([expected, expected], abs=1e-6)
+        assert record["targets_per_row"] == 2
+    torch.testing.assert_close(model.calls[0][2], model.calls[1][2])
+    torch.testing.assert_close(model.calls[2][2], model.calls[3][2])
+    assert not torch.equal(model.calls[0][2], model.calls[2][2])
+
+
+def test_latent_noise_is_independent_of_batch_size_and_global_rng():
+    ids = torch.tensor([[0, 1], [1, 2]])
+    first, second = Probe(), Probe()
+    state = torch.get_rng_state().clone()
+    measure_depths(first, ids, depths=[1], seeds=[3], batch_size=2, warmup=False)
+    measure_depths(second, ids, depths=[1], seeds=[3], batch_size=1, warmup=False)
+    assert torch.equal(state, torch.get_rng_state())
+    torch.testing.assert_close(first.calls[0][2], torch.cat([c[2] for c in second.calls]))
+
+
+@pytest.mark.parametrize("depths", [[], [0], [2, 2]])
+def test_depth_sweep_rejects_invalid_depths(depths):
+    with pytest.raises(ValueError):
+        measure_depths(Probe(), torch.tensor([[1, 2]]), depths=depths, seeds=[0])
