index 0000000000000000000000000000000000000000..47c7c638ba6975c9eaa07969e1c57889a480db0b
--- /dev/null
+++ b/src/spalmer/training/depth_evaluation.py
@@ -0,0 +1,129 @@
+"""Paired NLL/depth measurements with a fixed token view and latent noise."""
+
+from __future__ import annotations
+
+import random
+import time
+from collections.abc import Callable, Sequence
+
+import torch
+from torch.nn import functional as F
+
+
+@torch.inference_mode()
+def measure_depths(
+    model,
+    input_ids: torch.Tensor,
+    *,
+    depths: Sequence[int],
+    seeds: Sequence[int],
+    batch_size: int = 4,
+    warmup: bool = True,
+    progress: Callable[[dict], None] | None = None,
+) -> list[dict]:
+    """Score every row at every depth/seed, without training or decode caches.
+
+    Each row is an independent document window, including one context token.
+    Explicit FP32 Gaussian latent starts are paired across all depths. Depth
+    order rotates randomly within each batch to spread warm-cache/order effects.
+    NLL is recomputed in FP32 and excludes auxiliary/calibration objectives.
+    Time includes synchronized forward + NLL scoring, but excludes input/noise
+    creation and host result serialization. CUDA memory is process allocation,
+    including the loaded model; it is not total device utilization.
+    """
+    recurrence = model.config.recurrence
+    if recurrence is None:
+        raise ValueError("depth evaluation requires a trained recurrent model")
+    if input_ids.ndim != 2 or input_ids.shape[0] == 0 or input_ids.shape[1] < 2:
+        raise ValueError("input_ids must contain nonempty document windows and targets")
+    if batch_size < 1 or not depths or not seeds:
+        raise ValueError("batch_size, depths and seeds must be nonempty/positive")
+    if any(not isinstance(d, int) or d < 1 for d in depths) or len(set(depths)) != len(depths):
+        raise ValueError("depths must be distinct positive integers")
+    if any(not isinstance(s, int) or s < 0 for s in seeds) or len(set(seeds)) != len(seeds):
+        raise ValueError("seeds must be distinct non-negative integers")
+    device = model.execution_device
+    cuda = device.type == "cuda"
+    records = []
+    was_training = model.training
+    model.eval()
+
+    def noise(batch, seed, offset):
+        # Per-row seeds keep initialization independent of evaluation batch size.
+        return (
+            torch.stack(
+                [
+                    torch.randn(
+                        batch.shape[1],
+                        model.config.d_model,
+                        device=device,
+                        dtype=torch.float32,
+                        generator=torch.Generator(device=device).manual_seed(
+                            seed * 1_000_003 + offset + row
+                        ),
+                    )
+                    for row in range(batch.shape[0])
+                ]
+            )
+            * recurrence.latent_init_std
+        )
+
+    def score(batch, latent, depth):
+        output = model(batch, recurrence_steps=depth, latent_init=latent, use_cache=False)
+        if output.token_mixer_states or output.channel_mixer_states:
+            raise RuntimeError("depth evaluation requires native use_cache=False support")
+        losses = F.cross_entropy(
+            output.logits[:, :-1].float().transpose(1, 2), batch[:, 1:], reduction="none"
+        )
+        return losses.double().sum(dim=1), output.latent_deltas[-1].float()
+
+    try:
+        if warmup:
+            batch = input_ids[:batch_size].to(device=device, dtype=torch.long)
+            latent = noise(batch, seeds[0], 0)
+            for depth in depths:
+                score(batch, latent, depth)
+            if cuda:
+                torch.cuda.synchronize(device)
+        for seed in seeds:
+            for offset in range(0, len(input_ids), batch_size):
+                batch = input_ids[offset : offset + batch_size].to(device=device, dtype=torch.long)
+                latent = noise(batch, seed, offset)
+                order = list(depths)
+                random.Random(f"depth-eval:{seed}:{offset}").shuffle(order)
+                for depth in order:
+                    if cuda:
+                        torch.cuda.synchronize(device)
+                        torch.cuda.reset_peak_memory_stats(device)
+                    start = time.perf_counter()
+                    nll, delta = score(batch, latent, depth)
+                    if cuda:
+                        torch.cuda.synchronize(device)
+                    elapsed = time.perf_counter() - start
+                    peak = torch.cuda.max_memory_allocated(device) if cuda else None
+                    nll_values = nll.cpu().tolist()
+                    if not all(torch.isfinite(nll).tolist()):
+                        raise RuntimeError("nonfinite evaluation NLL")
+                    records.append(
+                        {
+                            "seed": seed,
+                            "depth": depth,
+                            "row_start": offset,
+                            "nll_sums": nll_values,
+                            "targets_per_row": batch.shape[1] - 1,
+                            "seconds": elapsed,
+                            "peak_allocated_bytes": peak,
+                            "latent_delta_final": float(delta),
+                        }
+                    )
+                if progress is not None:
+                    progress(
+                        {
+                            "seed": seed,
+                            "documents_scored": min(offset + batch_size, len(input_ids)),
+                            "total_documents": len(input_ids),
+                        }
+                    )
+    finally:
+        model.train(was_training)
+    return records
