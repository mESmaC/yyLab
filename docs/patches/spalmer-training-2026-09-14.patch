+def config(weight="nvfp4", execution="loop"):
+    return MicroExpertsConfig(
+        d_model=128, num_experts=3, expert_inter_dim=128,
+        active_experts=1, min_active_experts=1, max_active_experts=3,
+        min_resident_experts=1, max_resident_experts=3,
+        expert_weight_format=weight, expert_activation_format=weight,
+        expert_master_dtype="float32", expert_execution=execution,
+        potentiation_budget=0,
+    )
