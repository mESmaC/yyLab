index 0000000000000000000000000000000000000000..f839b4a1f7a861265a8a5a3ab21aaadb09af0ec4
--- /dev/null
+++ b/tests/core/test_runtime_standard_precision.py
@@ -0,0 +1,87 @@
+"""Standard AMP preserves authoritative state and spans inference dispatch."""
+
+import sys
+from contextlib import contextmanager
+from types import ModuleType, SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+
+from spalmer.runtime import generate_tokens, model_compute_context
+
+
+class ComputeProbe(nn.Module):
+    def __init__(self, compute="bfloat16", master="float32"):
+        super().__init__()
+        self.lm_head = nn.Linear(4, 8, bias=False)
+        self.config = SimpleNamespace(recurrence=None, vocab_size=8, d_model=4, n_layers=4)
+        self.residency = SimpleNamespace(config=SimpleNamespace(
+            expert_weight_format=compute, expert_activation_format=compute,
+            expert_master_dtype=master,
+        ))
+        self.calls = []
+        self.fail = False
+
+    @property
+    def execution_device(self):
+        return self.lm_head.weight.device
+
+    def forward(self, input_ids, **kwargs):
+        self.calls.append((
+            input_ids.shape[1], kwargs.get("execution_mode"),
+            torch.is_autocast_enabled("cpu"),
+        ))
+        if self.fail:
+            raise ValueError("intentional forward failure")
+        hidden = torch.ones((*input_ids.shape, 4))
+        logits = self.lm_head(hidden)
+        return SimpleNamespace(logits=logits, token_mixer_states=(), channel_mixer_states=())
+
+
+@pytest.mark.parametrize("compute", ["bfloat16", "nvfp4"])
+def test_generation_enters_one_recipe_context_for_prefill_and_decode(compute, monkeypatch):
+    events = []
+    module = ModuleType("spalmer.experts.standard_nvfp4")
+
+    @contextmanager
+    def provider(device):
+        assert device == torch.device("cpu")
+        events.append("enter")
+        try:
+            yield
+        finally:
+            events.append("exit")
+
+    module.standard_nvfp4_execution = provider
+    monkeypatch.setitem(sys.modules, module.__name__, module)
+    model = ComputeProbe(compute)
+    saved = model.lm_head.weight.detach().clone()
+    result = generate_tokens(model, torch.tensor([1, 3]), max_new_tokens=3)
+    assert result.shape == (1, 5)
+    assert model.calls == [(2, None, True), (1, "decode", True), (1, "decode", True)]
+    assert events == (["enter", "exit"] if compute == "nvfp4" else [])
+    assert model.training
+    assert model.lm_head.weight.dtype == torch.float32
+    torch.testing.assert_close(model.lm_head.weight, saved, rtol=0, atol=0)
+    assert not torch.is_autocast_enabled("cpu")
+
+    model.fail = True
+    with pytest.raises(ValueError, match="intentional"):
+        generate_tokens(model, torch.tensor([1]), max_new_tokens=1)
+    assert model.training
+    assert not torch.is_autocast_enabled("cpu")
+    assert events == (["enter", "exit"] * 2 if compute == "nvfp4" else [])
+
+
+def test_context_preserves_fp32_parameter_gradients_and_old_recipe_behavior():
+    model = ComputeProbe()
+    with model_compute_context(model):
+        result = model(torch.tensor([[1, 2]]))
+        assert result.logits.dtype == torch.bfloat16
+        result.logits.float().square().mean().backward()
+    assert model.lm_head.weight.dtype == torch.float32
+    assert model.lm_head.weight.grad.dtype == torch.float32
+    for compute, master in (("float32", "float32"), ("bfloat16", "bfloat16")):
+        with model_compute_context(ComputeProbe(compute, master)):
+            assert not torch.is_autocast_enabled("cpu")
