index 0000000000000000000000000000000000000000..6df2c9646e5667190c655dbc2c219a9e68de2aca
--- /dev/null
+++ b/src/spalmer/training/rounding.py
@@ -0,0 +1,168 @@
+"""Stochastic BF16 optimizer writeback with optional fused CUDA rounding.
+
+The native path retains Torch's conversion of the original values and its one
+FP32 random draw per element. A single optional Triton kernel handles finite
+clamping, neighboring BF16 values, probability, and selection. No optimizer
+state, weight master, random generator, or device capability cache is stored.
+CPU and unsupported inputs retain the original Torch formula.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Literal
+
+import torch
+from torch import Tensor
+
+try:
+    import triton
+    import triton.language as tl
+except ImportError:
+    triton = None
+    tl = None
+
+
+if triton is not None:
+
+    @triton.jit(do_not_specialize=["count"])
+    def _rounding_kernel(Values, NearestBits, Draws, OutputBits, count, BLOCK: tl.constexpr):
+        index = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+        valid = index < count
+        value = tl.load(Values + index, valid, other=0)
+        original_nearest = tl.load(NearestBits + index, valid, other=0).to(tl.uint32)
+        draw = tl.load(Draws + index, valid, other=0)
+        maximum: tl.constexpr = 3.3895313892515355e38
+        above = value > maximum
+        below = value < -maximum
+        bounded = tl.where(above, maximum, tl.where(below, -maximum, value))
+        # Torch's original-input conversion is also the clamped conversion for
+        # in-range values. Finite overflow clamps to the exact BF16 endpoints.
+        nearest = tl.where(above, 0x7F7F, tl.where(below, 0xFF7F, original_nearest))
+        nearest_fp32 = (nearest << 16).to(tl.float32, bitcast=True)
+        zero = (nearest & 0x7FFF) == 0
+        negative = (nearest & 0x8000) != 0
+        next_down = tl.where(zero, 0x8001, tl.where(negative, nearest + 1, nearest - 1))
+        next_up = tl.where(zero, 0x0001, tl.where(negative, nearest - 1, nearest + 1))
+        lower = tl.where(nearest_fp32 > bounded, next_down, nearest)
+        upper = tl.where(nearest_fp32 < bounded, next_up, nearest)
+        lower_fp32 = (lower << 16).to(tl.float32, bitcast=True)
+        upper_fp32 = (upper << 16).to(tl.float32, bitcast=True)
+        span = upper_fp32 - lower_fp32
+        # Preserve the separate FP32 subtraction/division and strict draw < p.
+        probability = tl.div_rn(bounded - lower_fp32, span)
+        probability = tl.where(span > 0, tl.minimum(tl.maximum(probability, 0.0), 1.0), 0.0)
+        rounded = tl.where(draw < probability, upper, lower)
+        finite = (value.to(tl.uint32, bitcast=True) & 0x7F800000) != 0x7F800000
+        # Original Torch cast preserves its own NaN payload/sign convention,
+        # infinities, and negative zero without relying on Triton's BF16 cast.
+        result = tl.where(finite, rounded, original_nearest).to(tl.uint16)
+        tl.store(OutputBits + index, result, valid)
+
+
+def _torch_round(values: Tensor, draws: Tensor | None = None) -> Tensor:
+    """Literal existing formula, including random tensor layout and edge cases."""
+
+    maximum = torch.finfo(torch.bfloat16).max
+    bounded = values.clamp(min=-maximum, max=maximum)
+    nearest = bounded.to(torch.bfloat16)
+    nearest_fp32 = nearest.float()
+    lower = torch.where(
+        nearest_fp32 > bounded,
+        torch.nextafter(nearest, torch.full_like(nearest, float("-inf"))),
+        nearest,
+    )
+    upper = torch.where(
+        nearest_fp32 < bounded,
+        torch.nextafter(nearest, torch.full_like(nearest, float("inf"))),
+        nearest,
+    )
+    lower_fp32 = lower.float()
+    upper_fp32 = upper.float()
+    span = upper_fp32 - lower_fp32
+    probability = torch.where(
+        span > 0,
+        ((bounded - lower_fp32) / span).clamp(0.0, 1.0),
+        torch.zeros_like(bounded),
+    )
+    if draws is None:
+        draws = torch.rand_like(probability)
+    rounded = torch.where(draws < probability, upper, lower)
+    return torch.where(torch.isfinite(values), rounded, values.to(torch.bfloat16))
+
+
+def _canonical_contiguous(values: Tensor) -> bool:
+    # is_contiguous alone also accepts arbitrary strides on singleton/empty
+    # dimensions. Torch's probability tensor normalizes those strides, while
+    # rand_like(values) preserves them, so retain the reference for that case.
+    if not values.is_contiguous():
+        return False
+    expected = 1
+    for size, stride in zip(reversed(values.shape), reversed(values.stride()), strict=True):
+        if stride != expected:
+            return False
+        expected *= max(size, 1)
+    return True
+
+
+def _native_supported(values: Tensor, *, interpreter: bool = False) -> bool:
+    return (
+        triton is not None
+        and type(values) is Tensor
+        and values.dtype == torch.float32
+        and values.layout == torch.strided
+        and _canonical_contiguous(values)
+        and not values.is_neg()
+        and not values.is_conj()
+        and not values.requires_grad
+        and (values.device.type == "cuda" or (interpreter and values.device.type == "cpu"))
+    )
+
+
+def _native_round(values: Tensor, draws: Tensor | None = None) -> Tensor:
+    nearest = values.to(torch.bfloat16)
+    if draws is None:
+        # For contiguous FP32 inputs the original probability tensor has this
+        # exact shape/stride/dtype. Keep Torch's call and generator consumption.
+        draws = torch.rand_like(values)
+    if values.numel() == 0:
+        return nearest
+    output = torch.empty_like(nearest)
+    _rounding_kernel[(triton.cdiv(values.numel(), 512),)](
+        values,
+        nearest.reshape(-1).view(torch.uint16),
+        draws,
+        output.reshape(-1).view(torch.uint16),
+        values.numel(),
+        BLOCK=512,
+        num_warps=4,
+        enable_fp_fusion=False,
+    )
+    return output
+
+
+def stochastic_round_bfloat16(
+    values: Tensor, *, backend: Literal["auto", "torch", "triton"] = "auto"
+) -> Tensor:
+    """Round with Torch RNG; explicit Triton is for isolated parity/timing tests.
+
+    ``auto`` uses native only for canonically contiguous FP32 CUDA inputs
+    without autograd.
+    The reference handles CPU, other layouts/dtypes, missing Triton, and values
+    requiring gradients. Explicit ``triton`` rejects unsupported metadata; it
+    also allows CPU only under ``TRITON_INTERPRET=1``. Launch failures propagate
+    without retrying or consuming another set of draws. No GPU query occurs.
+    """
+
+    if backend not in {"auto", "torch", "triton"}:
+        raise ValueError(f"unknown BF16 rounding backend: {backend!r}")
+    interpreter = backend == "triton" and os.environ.get("TRITON_INTERPRET") == "1"
+    supported = _native_supported(values, interpreter=interpreter)
+    if backend == "triton" and not supported:
+        raise ValueError("Triton rounding requires contiguous FP32 CUDA values without autograd")
+    if backend == "torch" or not supported:
+        return _torch_round(values)
+    return _native_round(values)
+
+
+__all__ = ["stochastic_round_bfloat16"]
