+"""Both text-index generations flow through existing native data consumers."""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from spalmer.data import CorpusManifest, MMapTokenShard, prepare_approved_jsonl
+from spalmer.data.discovery import discover_jsonl, iter_approved_jsonl
+from spalmer.data.text_index import build_text_index, iter_indexed_text
+from spalmer.experiment.pilot_data import byte_vocab
+from spalmer.experiment.pilot_mixture import PilotMixture
+from spalmer.tokenizer.backends import RPDTokenizerAdapter, SpecialTokenIds
+
+
+def _index(tmp_path, preprocessing):
+    source = tmp_path / "books"
+    source.mkdir()
+    originals = {}
+    for split in ("train", "validation", "test"):
+        text = (
+            f"The {split} narrator described the quiet village beside the river while the\r\n"
+            "reader considered the stories that people had passed down through many years.\r\n"
+            "\r\n"
+        ) * 3
+        originals[split] = text.encode("utf-8")
+        (source / f"{split}.txt").write_bytes(originals[split])
+    index = tmp_path / "index"
+    manifest = build_text_index(
+        source,
+        index,
+        validation_files=["validation.txt"],
+        test_files=["test.txt"],
+        preprocessing=preprocessing,
+    )
+    return source, index, manifest, originals
+
+
+@pytest.mark.parametrize("preprocessing", [None, "prose_v1"])
+def test_discovery_and_direct_shards_preserve_index_rendering_and_splits(tmp_path, preprocessing):
+    source, index, manifest, originals = _index(tmp_path, preprocessing)
+    expected_schema = f"spalmer.text-source-index/{1 if preprocessing is None else 2}"
+    assert manifest["schema"] == expected_schema
+    rows = {row["document_id"]: row for row in iter_indexed_text(index)}
+    discovered = discover_jsonl([index / "text-index.json"])
+    adapted = list(iter_approved_jsonl(discovered))
+    assert len(adapted) == len(rows) == 3
+    for document in adapted:
+        row = rows[document.document_id]
+        assert document.text == row["text"]
+        attributes = document.to_dict()["attributes"]
+        assert attributes["split"] == row["split"]
+        assert attributes["provenance"] == row["provenance"]
+        if preprocessing is None:
+            assert document.text.encode("utf-8") == originals[row["split"]]
+        else:
+            assert "\r" not in document.text
+
+    tokenizer = RPDTokenizerAdapter(byte_vocab(), special_tokens=SpecialTokenIds(eod_id=256))
+    prepared = prepare_approved_jsonl([index], tmp_path / "tokens", tokenizer, name="books")
+    corpus = CorpusManifest.load(prepared.manifest_path)
+    assert {document.split for document in corpus.selected_documents} == {
+        "train",
+        "validation",
+        "test",
+    }
+    seen = set()
+    for path in prepared.shard_indexes:
+        with MMapTokenShard(path) as shard:
+            for document in shard.descriptor.documents:
+                row = rows[document.document_id]
+                ids = shard.read_tokens(document.token_start, document.stored_token_count)
+                assert ids == tuple(row["text"].encode("utf-8")) + (256,)
+                assert document.split == row["split"]
+                seen.add(document.document_id)
+    assert seen == set(rows)
+    assert not (prepared.output_directory / ".document-spool").exists()
+    assert {path.stem: path.read_bytes() for path in source.glob("*.txt")} == originals
+
+
+@pytest.mark.parametrize("preprocessing", [None, "prose_v1"])
+def test_pilot_mixture_delegates_schema_and_keeps_rendered_payloads(tmp_path, preprocessing):
+    source, index, _, originals = _index(tmp_path, preprocessing)
+    rows = {row["document_id"]: row for row in iter_indexed_text(index)}
+    config = {
+        "schema": "spalmer.pilot-mixture/1",
+        "sources": [
+            {
+                "name": "books",
+                "type": "raw_text_index",
+                "path": index.name,
+                "weight": 1,
+                "domain": "prose",
+            }
+        ],
+    }
+    config_path = tmp_path / "mixture.json"
+    config_path.write_text(json.dumps(config), encoding="utf-8")
+    pool = PilotMixture(config_path, 8)
+    for split in ("train", "validation"):
+        assert len(pool.documents[split]) == 1
+        for payload, source_id, document_id in pool.documents[split]:
+            assert source_id == 0
+            assert payload == rows[document_id]["text"].encode("utf-8")
+            assert rows[document_id]["split"] == split
+    assert not pool.hashes["train"] & pool.hashes["validation"]
+    assert {row["split"] for row in pool.selection} == {"train", "validation"}
+    assert all(row["provenance"]["classified"] is False for row in pool.selection)
+    assert {path.stem: path.read_bytes() for path in source.glob("*.txt")} == originals
