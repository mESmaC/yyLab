+"""CPU checks for stock FP32 optimization and whole-step NVFP4 context ownership."""
+
+import sys
+from contextlib import contextmanager
+from types import ModuleType, SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+
+from spalmer.training import ExperimentTrainer, TrainingConfig
+from spalmer.training.engine import _validate_expert_master_dtype
+from spalmer.training.optim import BF16MasterAdamW, build_optimizers
+
+
+def training_config(**kwargs):
+    return TrainingConfig(
+        max_steps=2, micro_batch_size=1, sequence_length=2,
+        device="cpu", require_cuda=False, parameter_dtype="float32",
+        stochastic_parameter_rounding=False, fused_adamw="off", **kwargs,
+    )
+
+
+def test_explicit_fp32_uses_stock_adamw_and_fp32_moments():
+    model = nn.Linear(3, 2, bias=False)
+    optimizer = build_optimizers(model, training_config())
+    assert type(optimizer.dense) is torch.optim.AdamW
+    assert not isinstance(optimizer.dense, BF16MasterAdamW)
+    assert optimizer.sparse is None
+    previous = model.weight.detach().clone()
+    model(torch.ones(2, 3)).square().sum().backward()
+    optimizer.step()
+    assert not torch.equal(model.weight, previous)
+    assert model.weight.dtype == model.weight.grad.dtype == torch.float32
+    state = optimizer.dense.state[model.weight]
+    assert state["exp_avg"].dtype == state["exp_avg_sq"].dtype == torch.float32
+
+
+@pytest.mark.parametrize("weight", ["bfloat16", "nvfp4"])
+def test_new_fp32_recipes_require_bf16_training_compute(weight):
+    experts = SimpleNamespace(expert_weight_format=weight, expert_master_dtype="float32")
+    block = SimpleNamespace(channel_mixer=SimpleNamespace(experts=SimpleNamespace(config=experts)))
+    model = SimpleNamespace(backbone=SimpleNamespace(blocks=[block]))
+    _validate_expert_master_dtype(model, training_config())
+    with pytest.raises(ValueError, match="compute_dtype='bfloat16'"):
+        _validate_expert_master_dtype(model, training_config(compute_dtype="float32"))
+
+
+@pytest.mark.parametrize("finish", ["exhaust", "close", "error"])
+def test_standard_context_covers_complete_run_and_restores(monkeypatch, finish):
+    active = []
+    events = []
+
+    @contextmanager
+    def context(device):
+        assert device == torch.device("cpu")
+        active.append(True)
+        events.append("enter")
+        try:
+            yield
+        finally:
+            active.pop()
+            events.append("exit")
+
+    module = ModuleType("spalmer.experts.standard_nvfp4")
+    module.standard_nvfp4_execution = context
+    monkeypatch.setitem(sys.modules, module.__name__, module)
+    trainer = object.__new__(ExperimentTrainer)
+    trainer.model = nn.Linear(1, 1)
+    trainer.model.residency = SimpleNamespace(config=SimpleNamespace(
+        expert_weight_format="nvfp4", expert_activation_format="nvfp4",
+        expert_master_dtype="float32",
+    ))
+    trainer.config = SimpleNamespace(max_steps=2)
+    trainer.runtime = SimpleNamespace(device=torch.device("cpu"))
+    trainer.progress = SimpleNamespace(started_at=0, completed_steps=0)
+
+    def step():
+        assert active
+        trainer.progress.completed_steps += 1
+        if finish == "error" and trainer.progress.completed_steps == 2:
+            raise ValueError("backward failed")
+        return trainer.progress.completed_steps
+
+    trainer._optimizer_step = step
+    iterator = trainer.run()
+    assert not active
+    assert next(iterator) == 1
+    assert active  # compatibility remains valid across yielded steps/callbacks
+    if finish == "close":
+        iterator.close()
+    elif finish == "error":
+        with pytest.raises(ValueError, match="backward failed"):
+            next(iterator)
+    else:
+        assert list(iterator) == [2]
+    assert not active
+    assert events == ["enter", "exit"]
+
+
+def test_other_recipes_do_not_import_or_enter_nvfp4_context(monkeypatch):
+    from spalmer.training.engine import _training_execution_context
+
+    monkeypatch.setitem(sys.modules, "spalmer.experts.standard_nvfp4", None)
+    for weight, activation, master in (
+        ("bfloat16", "bfloat16", "bfloat16"),
+        ("bfloat16", "bfloat16", "float32"),
+        ("nvfp4", "mxfp8", "bfloat16"),
+        ("nvfp4", "nvfp4", "bfloat16"),
+    ):
+        model = SimpleNamespace(residency=SimpleNamespace(config=SimpleNamespace(
+            expert_weight_format=weight, expert_activation_format=activation,
+            expert_master_dtype=master,
+        )))
+        with _training_execution_context(model, torch.device("cpu")):
+            pass
