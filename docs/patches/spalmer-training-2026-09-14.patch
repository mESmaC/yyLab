+"""Explicit FP32 masters preserve the older default plans and precision tuples."""
+
+from dataclasses import replace
+
+import pytest
+
+from spalmer.experiment import (
+    DirectionalScaleConfig,
+    ExplicitVocabularyPolicy,
+    MemoryAssumptions,
+    ScaleSearchSpace,
+    plan_configuration,
+    plan_ladder,
+)
+from spalmer.experts import MicroExpertsConfig
+from spalmer.presets import build_configs, plan_named_scale
+
+
+def aligned_search():
+    return ScaleSearchSpace(
+        d_models=(128,), n_layers=(4,), num_heads=(4,), num_experts=25,
+        expert_width_divisors=(1,), shared_width_multipliers=(1,), ple_expansions=(4,),
+    )
+
+
+def aligned_plan(**kwargs):
+    return plan_configuration(
+        10_000_000, 16_384, search_space=aligned_search(),
+        directional=DirectionalScaleConfig(num_feature_groups=4, lateral_rank=16),
+        **kwargs,
+    )
+
+
+@pytest.mark.parametrize(
+    "weight,activation,fingerprint",
+    [
+        ("bfloat16", None, "573e2a2957db6f3eae9bca1270a3293842cc729bce7a66590af3384d2427a016"),
+        ("nvfp4", None, "5dc9ebe5c991819d37bb3bc459a98c3f7a7d8ed7d45844d4a240a230a6289b29"),
+        ("nvfp4", "mxfp8", "b4050bdd10d87f5b5ba2b6282bbc30f8e9074be360901c32c024699a77d58532"),
+        ("float32", None, "4a31f8d01ad2f075d9d7c2724b95ab3b06446f3ec9a3df2d444842b46f5030c6"),
+    ],
+)
+def test_prechange_default_plan_fingerprints(weight, activation, fingerprint):
+    # These hashes were captured from the original planner before this change.
+    assert aligned_plan(
+        expert_weight_format=weight, expert_activation_format=activation,
+    ).fingerprint == fingerprint
+
+
+@pytest.mark.parametrize("weight", ["bfloat16", "nvfp4"])
+def test_aligned_10m_plan_has_fp32_state_and_bf16_promotion(weight):
+    plan = aligned_plan(expert_weight_format=weight, expert_master_dtype="float32")
+    assert plan.parameters.total == 10_005_123
+    assert plan.config.recurrence is None
+    assert plan.config.expert_master_dtype == "float32"
+    assert plan.memory.reference_weights_bytes == 4 * plan.parameters.total
+    assert plan.memory.reference_gradients_bytes == 4 * plan.parameters.total
+    assert plan.memory.optimizer_bytes == 8 * plan.parameters.total
+    assert plan.memory.hypothetical_master_weights_bytes == 4 * plan.parameters.total
+    assert plan.memory.reference_training_bytes == int(16 * plan.parameters.total * 1.1)
+    assert plan.fingerprint != aligned_plan(expert_weight_format=weight).fingerprint
+    bundle = build_configs(plan, tokenizer_version=1, tokenizer_fingerprint="fp32-test")
+    assert bundle.experts.expert_promotion_format == "bfloat16"
+    assert bundle.experts.potentiation_budget == 0
+    assert bundle.experts.expert_master_bits == 32
+    assert bundle.experts.expert_activation_format == weight
+
+
+def test_explicit_memory_estimates_are_still_caller_owned():
+    assumptions = MemoryAssumptions(
+        reference_weight_bits=32, reference_gradient_bits=32,
+        hypothetical_master_weight_bits=32, optimizer_slots=0, overhead_fraction=0,
+    )
+    plan = aligned_plan(expert_master_dtype="float32", memory_assumptions=assumptions)
+    assert plan.memory.optimizer_bytes == 0
+    assert plan.memory.reference_training_bytes == 8 * plan.parameters.total
+
+
+def test_planner_filters_only_new_nvfp4_weight_alignment():
+    search = replace(aligned_search(), d_models=(96, 128), expert_width_divisors=(1, 2))
+    plan = plan_configuration(
+        10_000_000, 16_384, search_space=search,
+        expert_weight_format="nvfp4", expert_master_dtype="float32",
+    )
+    assert plan.config.d_model == plan.config.expert_width == 128
+    with pytest.raises(ValueError, match="no valid"):
+        plan_configuration(
+            10_000_000, 16_384, search_space=replace(search, d_models=(96,)),
+            expert_weight_format="nvfp4", expert_master_dtype="float32",
+        )
+    # Historical low-precision metadata does not gain new shape restrictions.
+    old = plan_configuration(
+        10_000_000, 16_384, search_space=replace(search, d_models=(96,)),
+        expert_weight_format="nvfp4",
+    )
+    assert old.config.d_model == 96
+
+
+def test_named_scale_and_ladder_forward_the_explicit_master():
+    named = plan_named_scale(
+        "10M", vocab_size=16_384, search_space=aligned_search(),
+        expert_weight_format="nvfp4", expert_master_dtype="float32",
+    )
+    ladder, = plan_ladder(
+        (10_000_000,), ExplicitVocabularyPolicy(((10_000_000, 16_384),)),
+        search_space=aligned_search(), expert_weight_format="nvfp4",
+        expert_master_dtype="float32",
+    )
+    assert named == ladder
+    assert named.memory.reference_weights_bytes == named.parameters.total * 4
+
+
+@pytest.mark.parametrize(
+    "overrides,message",
+    [
+        ({"expert_activation_format": "mxfp8"}, "NVFP4 weights and activations"),
+        ({"expert_weight_format": "mxfp4", "expert_activation_format": "mxfp8"}, "NVFP4"),
+        ({"expert_promotion_format": "mxfp8"}, "BF16 promotion"),
+        ({"expert_promotion_format": "float32"}, "BF16 promotion"),
+        ({"potentiation_budget": 1}, "zero potentiation_budget"),
+        ({"d_model": 96}, "divisible by 128"),
+        ({"expert_inter_dim": 64}, "divisible by 128"),
+    ],
+)
+def test_standard_nvfp4_rejects_ambiguous_or_unsupported_tuples(overrides, message):
+    values = dict(
+        d_model=128, expert_inter_dim=128, num_experts=25,
+        expert_weight_format="nvfp4", expert_activation_format="nvfp4",
+        expert_master_dtype="float32", expert_promotion_format="bfloat16",
+    )
+    with pytest.raises(ValueError, match=message):
+        MicroExpertsConfig(**(values | overrides))
+
+
+def test_fp32_control_keeps_bf16_compute_metadata_and_no_promotion():
+    config = MicroExpertsConfig(d_model=96, expert_master_dtype="float32")
+    assert config.expert_weight_format == config.expert_activation_format == "bfloat16"
+    assert config.expert_promotion_format == "bfloat16"
+    with pytest.raises(ValueError, match="promotion"):
+        replace(config, potentiation_budget=1)
+
+
+def test_explicit_invalid_master_does_not_fall_back_to_defaults():
+    with pytest.raises(ValueError, match="expert_master_dtype"):
+        aligned_plan(expert_master_dtype="")
