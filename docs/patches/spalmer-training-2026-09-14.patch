+"""Opt-in, conservative whitespace repair for raw prose source text.
+
+Callers choose whether to apply ``prose_v1``; bypass this module for an absent
+profile so legacy text remains unchanged. No Unicode normalization, character
+deletion, case conversion, or dehyphenation is performed. Reflow is deliberately
+limited to long, consistently wrapped prose paragraphs. Ambiguous blocks retain
+their layout. The fixed identity belongs in source/cache provenance; changing
+these rules requires a new profile version.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Iterator
+
+PROSE_PROFILE = "prose_v1"
+
+_MIN_LINES = 4
+_MIN_BODY_LENGTH = 52
+_MAX_BODY_LENGTH = 100
+_MAX_BODY_LENGTH_SPREAD = 20
+_MAX_FINAL_OVERRUN = 8
+_MIN_BODY_WORDS = 7
+_MIN_FINAL_WORDS = 2
+_MIN_ALPHA_PERCENT = 85
+_MAX_DIGIT_PERCENT = 5
+_MIN_SOFT_CONTINUATIONS = 2
+
+_FENCE = re.compile(r"^[ \t]*(`{3,}|~{3,})(.*)$")
+_STRUCTURED_START = re.compile(
+    r"^(?:[-+*\u2022\u2023]\s|[#>]|\(?\d+(?:\.\d+)*[.)]\s|"
+    r"\(?[A-Za-z][.)]\s|\(?[IVXLCDMivxlcdm]{1,8}[.)]\s)"
+)
+_CALL_START = re.compile(r"^[A-Za-z_]\w*\(")
+_STRUCTURED_CHARACTERS = "|=+*/\\<>^{}[]"
+_ENDING_HYPHENS = "-\u2010\u2011"
+_SENTENCE_ENDINGS = ".!?;:\u2026"
+
+
+def prose_profile_identity() -> dict[str, object]:
+    """Return a fresh, JSON-serializable identity for this exact fixed profile."""
+
+    return {
+        "name": PROSE_PROFILE,
+        "version": 1,
+        "line_endings": "CRLF_and_CR_to_LF",
+        "max_consecutive_newlines_outside_fences": 2,
+        "preserve_fenced_newline_runs": True,
+        "fences": {"markers": ["`", "~"], "minimum_length": 3},
+        "reflow": {
+            "unit": "entire_unindented_blank_line_delimited_block",
+            "minimum_lines": _MIN_LINES,
+            "body_line_length_minimum": _MIN_BODY_LENGTH,
+            "body_line_length_maximum": _MAX_BODY_LENGTH,
+            "body_line_length_spread_maximum": _MAX_BODY_LENGTH_SPREAD,
+            "final_line_overrun_maximum": _MAX_FINAL_OVERRUN,
+            "body_line_words_minimum": _MIN_BODY_WORDS,
+            "final_line_words_minimum": _MIN_FINAL_WORDS,
+            "alphabetic_percent_minimum_per_line_excluding_whitespace": _MIN_ALPHA_PERCENT,
+            "digit_percent_maximum_per_line_excluding_whitespace": _MAX_DIGIT_PERCENT,
+            "soft_continuations_minimum": _MIN_SOFT_CONTINUATIONS,
+            "soft_continuations_minimum_fraction": "one_half_of_line_boundaries",
+            "soft_continuation": "lowercase_start_after_nonterminal_nonhyphen_line",
+            "reject_any_indentation_or_tabs": True,
+            "reject_trailing_whitespace": True,
+            "reject_repeated_horizontal_whitespace": True,
+            "reject_all_uppercase_lines": True,
+            "structured_line_start_pattern": _STRUCTURED_START.pattern,
+            "function_call_line_start_pattern": _CALL_START.pattern,
+            "structured_characters": _STRUCTURED_CHARACTERS,
+            "rejected_unicode_categories": ["Sm"],
+            "reject_repeated_marks": ["--", "__", ".."],
+            "reject_body_line_ending_characters": _ENDING_HYPHENS,
+            "sentence_ending_characters": _SENTENCE_ENDINGS,
+            "join": "replace_each_accepted_LF_with_one_space",
+        },
+    }
+
+
+def preprocess_prose(text: str) -> str:
+    """Apply ``prose_v1``, preserving every non-whitespace character in order.
+
+    CRLF and lone CR become LF everywhere. Outside backtick/tilde code fences,
+    runs of three or more LF become two. Reflow requires at least three long
+    nonfinal lines plus a final line; all lines must pass the prose checks.
+    Code fences (including an unterminated fence) keep their internal layout.
+    """
+
+    if not isinstance(text, str):
+        raise TypeError("prose preprocessing requires text as str")
+    normalized = text.replace("\r\n", "\n").replace("\r", "\n")
+    pieces: list[str] = []
+    for fenced, value in _fenced_pieces(normalized):
+        if fenced:
+            pieces.append(value)
+            continue
+        value = re.sub(r"\n{3,}", "\n\n", value)
+        # Keep separators and leading/trailing LF exactly after normalization.
+        blocks = value.split("\n\n")
+        pieces.append("\n\n".join(_reflow_block(block) for block in blocks))
+    return "".join(pieces)
+
+
+def _fenced_pieces(text: str) -> Iterator[tuple[bool, str]]:
+    """Separate fences so internal blank lines survive outside normalization."""
+
+    pending: list[str] = []
+    marker = ""
+    marker_length = 0
+    lines = text.split("\n")
+    for index, line in enumerate(lines):
+        ending = "\n" if index < len(lines) - 1 else ""
+        match = _FENCE.match(line)
+        if not marker and match:
+            if pending:
+                yield False, "".join(pending)
+            pending = [line + ending]
+            marker = match[1][0]
+            marker_length = len(match[1])
+        elif marker:
+            closing = (
+                match is not None
+                and match[1][0] == marker
+                and len(match[1]) >= marker_length
+                and not match[2].strip()
+            )
+            if closing:
+                pending.append(line)
+                yield True, "".join(pending)
+                # The newline after the closing fence belongs to the outside
+                # paragraph separator, allowing its blank-line run to collapse.
+                pending = [ending] if ending else []
+                marker = ""
+            else:
+                pending.append(line + ending)
+        else:
+            pending.append(line + ending)
+    if pending:
+        yield bool(marker), "".join(pending)
+
+
+def _reflow_block(block: str) -> str:
+    lines = block.split("\n")
+    if len(lines) < _MIN_LINES or any(not _plain_prose_line(line) for line in lines):
+        return block
+    body = lines[:-1]
+    lengths = [len(line) for line in body]
+    if (
+        min(lengths) < _MIN_BODY_LENGTH
+        or max(lengths) > _MAX_BODY_LENGTH
+        or max(lengths) - min(lengths) > _MAX_BODY_LENGTH_SPREAD
+        or len(lines[-1]) > max(lengths) + _MAX_FINAL_OVERRUN
+        or any(len(line.split()) < _MIN_BODY_WORDS for line in body)
+        or len(lines[-1].split()) < _MIN_FINAL_WORDS
+        or any(line.endswith(tuple(_ENDING_HYPHENS)) for line in body)
+    ):
+        return block
+    soft_continuations = sum(
+        previous[-1] not in _SENTENCE_ENDINGS and following[0].islower()
+        for previous, following in zip(body, lines[1:])
+    )
+    if (
+        soft_continuations < _MIN_SOFT_CONTINUATIONS
+        or 2 * soft_continuations < len(body)
+    ):
+        return block
+    return " ".join(lines)
+
+
+def _plain_prose_line(line: str) -> bool:
+    if (
+        not line
+        or line[0].isspace()
+        or line[-1].isspace()
+        or "\t" in line
+        or line.isupper()
+        or re.search(r"[^\S\n]{2,}", line)
+        or _STRUCTURED_START.match(line)
+        or _CALL_START.match(line)
+        or any(character in line for character in _STRUCTURED_CHARACTERS)
+        or any(unicodedata.category(character) == "Sm" for character in line)
+        or any(mark in line for mark in ("--", "__", ".."))
+    ):
+        return False
+    characters = [character for character in line if not character.isspace()]
+    return (
+        100 * sum(character.isalpha() for character in characters)
+        >= _MIN_ALPHA_PERCENT * len(characters)
+        and 100 * sum(character.isdigit() for character in characters)
+        <= _MAX_DIGIT_PERCENT * len(characters)
+    )
+
+
+__all__ = ["PROSE_PROFILE", "preprocess_prose", "prose_profile_identity"]
