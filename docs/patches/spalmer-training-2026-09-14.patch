@@ -0,0 +1,143 @@
+"""Focused prose cleanup checks, including layouts that must remain intact."""
+
+import json
+import re
+import textwrap
+
+import pytest
+
+from spalmer.data.prose_preprocessing import (
+    PROSE_PROFILE,
+    preprocess_prose,
+    prose_profile_identity,
+)
+
+PROSE = (
+    "The children walked beside the river and watched the morning light move "
+    "across the water while their teacher described the history of the old "
+    "bridge. They stopped beneath the trees to listen to a story about the "
+    "people who had lived in the village and the journeys they had made "
+    "before the road was built. Each child carried a small notebook and "
+    "recorded the things that seemed most interesting along the way."
+)
+WRAPPED = textwrap.fill(PROSE, width=72)
+
+
+def test_reflows_clear_hard_wrapped_prose_without_changing_words():
+    assert len(WRAPPED.splitlines()) >= 4
+    assert preprocess_prose(WRAPPED) == PROSE
+
+
+def test_multiple_paragraphs_and_heading_keep_boundaries():
+    source = "CHAPTER IV\r\n\r\n" + WRAPPED + "\n\n\n\n" + WRAPPED
+    assert preprocess_prose(source) == "CHAPTER IV\n\n" + PROSE + "\n\n" + PROSE
+
+
+@pytest.mark.parametrize(
+    ("source", "expected"),
+    [
+        ("", ""),
+        ("plain text", "plain text"),
+        ("a\r\nb\rc\nd", "a\nb\nc\nd"),
+        ("a\n\n\nb\n\n\n\n", "a\n\nb\n\n"),
+        ("\n\n\na", "\n\na"),
+        ("a\n \n \nb", "a\n \n \nb"),
+        ("a\u0085b\u2028c\u2029d", "a\u0085b\u2028c\u2029d"),
+    ],
+)
+def test_newline_normalization(source, expected):
+    assert preprocess_prose(source) == expected
+
+
+@pytest.mark.parametrize(
+    "source",
+    [
+        "CHAPTER FOUR\nThe River and the Village\nA Morning Walk",
+        "The river runs\nand children watch\nthe morning sun\nthrough branches green",
+        "\n".join(WRAPPED.splitlines()[:3]),  # Too little evidence to reflow.
+        "\n".join("    " + line for line in WRAPPED.splitlines()),
+        "\n".join("- " + line for line in WRAPPED.splitlines()),
+        "\n".join(f"{index}. {line}" for index, line in enumerate(WRAPPED.splitlines(), 1)),
+        "\n".join("(a) " + line for line in WRAPPED.splitlines()),
+        "\n".join("> " + line for line in WRAPPED.splitlines()),
+        "\n".join("# " + line for line in WRAPPED.splitlines()),
+        "Name       Age       Village\n"
+        "Alice      11        Riverford\n"
+        "Bob        12        Millford",
+        "| apples | pears |\n| ------ | ----- |\n|    3   |   4   |",
+        "+------+\n|      |----> +---+\n+------+     | A |\n             +---+",
+        "x = a + b\ny = x * 2\nz = y / 3\nf(x) = x^2",
+        "A very long title standing on its own\n" + WRAPPED,
+        "THE HISTORY OF THE CHILDREN AND THEIR JOURNEYS AROUND THE VILLAGE\n" + WRAPPED,
+        "\n".join(line[0].upper() + line[1:] for line in WRAPPED.splitlines()),
+        "\n".join(WRAPPED.splitlines()[:-1] + ["End"]),
+        WRAPPED.replace("children", "chil-\ndren", 1),
+        WRAPPED.replace("\n", "-\n", 1),
+        WRAPPED.replace("river", "river\tbank", 1),
+        WRAPPED.replace("river", "river  bank", 1),
+        WRAPPED.replace("river", "river | bank", 1),
+        WRAPPED.replace("river", "river = bank", 1),
+        WRAPPED.replace("river", "river \u2211 bank", 1),
+        "\n".join(f'print("{line}")' for line in WRAPPED.splitlines()),
+    ],
+)
+def test_ambiguous_or_structured_blocks_are_preserved(source):
+    assert preprocess_prose(source) == source
+
+
+@pytest.mark.parametrize("marker", ["```", "~~~~", "    ```"])
+def test_fences_preserve_internal_blank_lines_and_wrapped_content(marker):
+    source = "before\n\n\n" + marker + "text\n\n\n" + WRAPPED + "\n\n\n" + marker
+    source += "\n\n\n\n" + WRAPPED
+    expected = "before\n\n" + marker + "text\n\n\n" + WRAPPED + "\n\n\n" + marker
+    expected += "\n\n" + PROSE
+    assert preprocess_prose(source) == expected
+
+
+def test_fence_end_requires_matching_marker_and_sufficient_length():
+    source = "````text\n" + WRAPPED + "\n```\n\n\n~~~\n" + WRAPPED + "\n````\n"
+    assert preprocess_prose(source) == source
+
+
+def test_unterminated_fence_preserves_remaining_layout_but_normalizes_crlf():
+    source = "~~~text\r\n\r\n\r\n" + WRAPPED.replace("\n", "\r\n")
+    assert preprocess_prose(source) == source.replace("\r\n", "\n")
+
+
+def test_unicode_words_punctuation_and_case_are_preserved():
+    prose = PROSE.replace("children", "enfants").replace("teacher", "maîtresse")
+    prose = prose.replace("village", "café").replace("old bridge", "old “bridge”")
+    wrapped = textwrap.fill(prose, width=72)
+    assert preprocess_prose(wrapped) == prose
+
+
+@pytest.mark.parametrize(
+    "source",
+    [
+        WRAPPED,
+        "\r\n\r\n\r\nTITLE\r\n\r\n" + WRAPPED + "\n\n\n",
+        "```\r\n\r\n\r\n" + WRAPPED + "\r\n```\r\n\r\n\r\n" + WRAPPED,
+        "αβγ\n\t∑(x) = 42\n\n\n" + WRAPPED,
+        "\n\n".join([WRAPPED, "Roses are red\nViolets are blue", WRAPPED]),
+    ],
+)
+def test_idempotent_and_nonwhitespace_sequence_is_exactly_preserved(source):
+    result = preprocess_prose(source)
+    assert preprocess_prose(result) == result
+    assert re.sub(r"\s", "", result) == re.sub(r"\s", "", source)
+
+
+def test_identity_is_json_serializable_fixed_and_returns_independent_nested_values():
+    identity = prose_profile_identity()
+    assert identity["name"] == PROSE_PROFILE == "prose_v1"
+    assert identity["version"] == 1
+    assert json.loads(json.dumps(identity)) == identity
+    expected = prose_profile_identity()
+    identity["reflow"]["minimum_lines"] = 1000
+    identity["fences"]["markers"].clear()
+    assert prose_profile_identity() == expected
+
+
+def test_non_text_is_rejected():
+    with pytest.raises(TypeError, match="str"):
+        preprocess_prose(b"raw bytes")
