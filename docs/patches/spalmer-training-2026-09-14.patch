diff --git a/src/spalmer/experts/standard_nvfp4.py b/src/spalmer/experts/standard_nvfp4.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a281e6f1fe0d709b7068f874f9ded8726518faa
--- /dev/null
+++ b/src/spalmer/experts/standard_nvfp4.py
@@ -0,0 +1,210 @@
+"""Upstream all-NVFP4 expert training with explicit FP32 master parameters.
+
+SM120 uses the separately verified SR conversion compatibility helper. The
+outer execution context must cover backward, evaluation and generation. It is
+nested-safe for one thread/device and never creates per-projection contexts.
+"""
+
+from __future__ import annotations
+
+import threading
+from contextlib import contextmanager
+from dataclasses import dataclass
+from functools import lru_cache
+
+import torch
+from torch import Tensor
+from torch.nn import functional as F
+
+PROVIDER_ID = "torchao_nvfp4_training_sm120_fp32_master"
+_EXECUTION = threading.local()
+
+
+@dataclass
+class _ExecutionSession:
+    device: torch.device
+    active: bool = True
+
+
+def _require_live_session(session: _ExecutionSession, device: torch.device) -> None:
+    if not session.active or session.device != device:
+        raise RuntimeError(
+            "standard NVFP4 forward and backward require their original enclosing "
+            "standard_nvfp4_execution(device) context to remain active"
+        )
+
+
+def _resolve_cuda(device: str | torch.device) -> torch.device:
+    resolved = torch.device(device)
+    if resolved.type != "cuda" or not torch.cuda.is_available():
+        raise RuntimeError("standard NVFP4 training requires CUDA; no emulation is provided")
+    index = torch.cuda.current_device() if resolved.index is None else resolved.index
+    return torch.device("cuda", index)
+
+
+def _require_execution(device: torch.device) -> _ExecutionSession:
+    active = getattr(_EXECUTION, "device", None)
+    if active != device:
+        raise RuntimeError(
+            "standard NVFP4 forward and backward require an enclosing "
+            "standard_nvfp4_execution(device) context"
+        )
+    session = _EXECUTION.session
+    _require_live_session(session, device)
+    return session
+
+
+@contextmanager
+def standard_nvfp4_execution(device: str | torch.device):
+    """One explicit SM120 execution session, including every backward call."""
+    active = getattr(_EXECUTION, "device", None)
+    requested = torch.device(device)
+    if active is not None:
+        if requested.type != "cuda" or requested.index not in {None, active.index}:
+            raise RuntimeError("nested standard NVFP4 contexts must use the same CUDA device")
+        yield getattr(_EXECUTION, "receipt")
+        return
+    resolved = _resolve_cuda(requested)
+    if torch.cuda.get_device_capability(resolved) != (12, 0):
+        raise RuntimeError("this standard NVFP4 provider is verified for SM120 only")
+    from spalmer.experts.nvfp4_sm120 import nvfp4_sm120_compatibility
+
+    with torch.cuda.device(resolved), nvfp4_sm120_compatibility() as receipt:
+        session = _ExecutionSession(resolved)
+        _EXECUTION.device = resolved
+        _EXECUTION.receipt = receipt
+        _EXECUTION.session = session
+        try:
+            yield receipt
+        finally:
+            session.active = False
+            del _EXECUTION.device
+            del _EXECUTION.receipt
+            del _EXECUTION.session
+
+
+class _ExecutionGuard(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, value, session):
+        _require_live_session(session, value.device)
+        ctx.device = value.device
+        ctx.session = session
+        return value
+
+    @staticmethod
+    def backward(ctx, gradient):
+        # CUDA autograd may execute this Python callback on an engine worker,
+        # which cannot see the frontend thread-local nesting state. The token
+        # ties backward to the original, still-live outer compatibility session.
+        _require_live_session(ctx.session, ctx.device)
+        return gradient, None
+
+
+def _pad_token_rows(input: Tensor) -> tuple[Tensor, int]:
+    """Differentiable padding only on token rows; never pad weight dimensions."""
+    flat = input.reshape(-1, input.shape[-1]).contiguous()
+    rows = flat.shape[0]
+    padded_rows = ((rows + 127) // 128) * 128
+    return F.pad(flat, (0, 0, 0, padded_rows - rows)) if padded_rows != rows else flat, rows
+
+
+def _upstream_linear(input, weight, bias, *, sr_seed, sign_vector):
+    from torchao.prototype.moe_training.nvfp4_training.nvfp4_linear import nvfp4_linear
+
+    return nvfp4_linear(input, weight, bias, sr_seed=sr_seed, sign_vector=sign_vector)
+
+
+def standard_nvfp4_matmul(
+    input: Tensor,
+    weight: Tensor,
+    bias: Tensor | None = None,
+    *,
+    sr_seed: Tensor,
+    sign_vector: tuple[int, ...],
+) -> Tensor:
+    """Compute input @ [in,out] FP32 master using all three upstream FP4 GEMMs."""
+    if input.device.type != "cuda" or input.device != weight.device:
+        raise RuntimeError("standard NVFP4 operands must share a CUDA device")
+    session = _require_execution(input.device)
+    if weight.dtype != torch.float32:
+        raise ValueError("standard NVFP4 authoritative weight parameters must be FP32")
+    if input.dtype not in {torch.float32, torch.bfloat16}:
+        raise ValueError("standard NVFP4 source activations must be FP32 or BF16")
+    if weight.ndim != 2 or input.ndim < 2 or input.shape[-1] != weight.shape[0]:
+        raise ValueError("standard NVFP4 input/weight dimensions are incompatible")
+    if weight.shape[0] % 128 or weight.shape[1] % 128:
+        raise ValueError("standard NVFP4 expert input/output widths must be divisible by 128")
+    if sr_seed.device != input.device or sr_seed.dtype != torch.int64 or sr_seed.numel() != 1:
+        raise ValueError("standard NVFP4 needs one persistent int64 seed on the execution device")
+    if len(sign_vector) != 16 or any(value not in {-1, 1} for value in sign_vector):
+        raise ValueError("standard NVFP4 requires a fixed 16-element signed RHT vector")
+    if bias is not None and (bias.device != input.device or bias.shape != (weight.shape[1],)):
+        raise ValueError("standard NVFP4 bias is incompatible")
+    original_shape = input.shape
+    padded, rows = _pad_token_rows(input.to(torch.bfloat16))
+    if rows == 0:
+        # A true empty route has no GEMM, but retains an autograd connection.
+        return input[..., :1].expand(*original_shape[:-1], weight.shape[1]) * 0 + weight.sum() * 0
+    output = _upstream_linear(
+        padded, weight.t().contiguous(), bias,
+        sr_seed=sr_seed.reshape(1), sign_vector=sign_vector,
+    )
+    sliced = output[:rows].reshape(*original_shape[:-1], weight.shape[1])
+    return _ExecutionGuard.apply(sliced, session)
+
+
+@lru_cache(maxsize=8)
+def _smoke_standard(device_index: int) -> tuple[bool, str]:
+    device = torch.device("cuda", device_index)
+    try:
+        with (
+            torch.random.fork_rng(devices=[device_index]),
+            torch.inference_mode(False), torch.enable_grad(),
+            standard_nvfp4_execution(device),
+        ):
+            generator = torch.Generator(device="cpu").manual_seed(4081)
+            x = torch.randn(3, 128, generator=generator).to(device).requires_grad_()
+            w = (torch.randn(128, 128, generator=generator) / 12).to(device).requires_grad_()
+            grad = torch.randn(3, 128, generator=generator).to(device, torch.bfloat16)
+            seed = torch.tensor([12345], device=device, dtype=torch.int64)
+            signs = tuple(1 if index % 3 else -1 for index in range(16))
+            y = standard_nvfp4_matmul(x, w, sr_seed=seed, sign_vector=signs)
+            y.backward(grad)
+            expected = (x.detach() @ w.detach(), grad.float() @ w.detach().t(),
+                        x.detach().t() @ grad.float())
+            actual = (y, x.grad, w.grad)
+            if any(value is None or not bool(torch.isfinite(value).all()) for value in actual):
+                raise RuntimeError("nonfinite standard NVFP4 forward/backward smoke")
+            if x.grad.dtype != torch.float32 or w.grad.dtype != torch.float32:
+                raise RuntimeError("standard NVFP4 smoke did not preserve FP32 gradients")
+            errors = [float((a.float() - b).norm() / b.norm().clamp_min(1e-12))
+                      for a, b in zip(actual, expected, strict=True)]
+            if max(errors) >= 0.5:
+                raise RuntimeError(f"standard NVFP4 smoke relative errors too large: {errors}")
+        return True, f"all-NVFP4 forward/dX/dW smoke passed; padded M=3; relative errors {errors}"
+    except Exception as error:
+        return False, f"standard NVFP4 smoke failed: {str(error)[:1800]}"
+
+
+def standard_nvfp4_provider_capability(device: str | torch.device) -> dict:
+    """Probe this exact FP32-master recipe once per CUDA device, preserving RNG."""
+    try:
+        resolved = _resolve_cuda(device)
+        available, detail = _smoke_standard(resolved.index)
+    except Exception as error:
+        available, detail = False, str(error)
+    return {
+        "provider_id": PROVIDER_ID, "weight_format": "nvfp4", "activation_format": "nvfp4",
+        "master_dtype": "float32", "forward_available": available,
+        "backward_available": available, "verified": available, "selectable": available,
+        "grouped_available": False, "detail": detail,
+        "backward_recipe": "NVFP4 RHT/2D scaling/stochastic rounding",
+        "weight_reconstruction_telemetry": "disabled; zero means not measured",
+    }
+
+
+def require_standard_nvfp4(device: str | torch.device) -> str:
+    report = standard_nvfp4_provider_capability(device)
+    if not report["selectable"]:
+        raise RuntimeError(report["detail"])
+    return report["provider_id"]
