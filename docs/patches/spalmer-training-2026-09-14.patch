index 0000000000000000000000000000000000000000..5c8b76944d9c9d507138233b8dc8a896f9971edc
--- /dev/null
+++ b/tests/experts/test_grouped_packing.py
@@ -0,0 +1,226 @@
+"""Exact integer maps and unchanged autograd around grouped expert buckets."""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+import torch
+from torch.nn import functional as F
+
+from spalmer.experts.bank import _power_of_two_count_buckets
+from spalmer.experts.grouped_packing import GroupedBucketIndices, grouped_bucket_indices
+
+
+def _routes(counts, *, dtype=torch.int64, device="cpu", resident_order=None):
+    generator = torch.Generator().manual_seed(173)
+    expert = torch.repeat_interleave(torch.arange(len(counts)), torch.tensor(counts))
+    expert = expert[torch.randperm(expert.numel(), generator=generator)]
+    tokens = torch.randint(0, 11, (expert.numel(),), generator=generator)
+    order = torch.argsort(expert, stable=True)
+    starts = torch.tensor(counts).cumsum(0) - torch.tensor(counts)
+    if resident_order is not None:
+        starts = starts[list(resident_order)]
+        counts = tuple(counts[position] for position in resident_order)
+    return (
+        order.to(device=device, dtype=dtype),
+        tokens.to(device=device, dtype=dtype),
+        starts.to(device=device, dtype=dtype),
+        list(counts),
+    )
+
+
+def _baseline(order, token_index, group_starts, *, capacity, positions, host_counts):
+    """Literal former executor index path, including its device prefix sum."""
+    device = order.device
+    group_positions = torch.tensor(positions, dtype=torch.long, device=device)
+    group_counts = torch.tensor(host_counts, dtype=torch.long, device=device)
+    bucket_counts = group_counts.index_select(0, group_positions)
+    bucket_starts = group_starts.index_select(0, group_positions)
+    slot = torch.arange(capacity, device=device)
+    gather = (bucket_starts[:, None] + slot[None, :]).clamp_max(order.numel() - 1)
+    pair_rows = order[gather]
+    token_rows = token_index[pair_rows]
+    real_count = sum(host_counts[position] for position in positions)
+    bucket_groups = torch.repeat_interleave(
+        torch.arange(len(positions), device=device), bucket_counts, output_size=real_count
+    )
+    bucket_offsets = torch.cumsum(bucket_counts, dim=0) - bucket_counts
+    real_slots = (
+        bucket_groups * capacity
+        + torch.arange(real_count, device=device)
+        - bucket_offsets.index_select(0, bucket_groups)
+    )
+    real_rows = pair_rows.reshape(-1).index_select(0, real_slots)
+    return GroupedBucketIndices(group_positions, token_rows, real_rows, real_slots)
+
+
+def _assert_maps(actual, expected):
+    for a, b in zip(actual, expected, strict=True):
+        torch.testing.assert_close(a, b, rtol=0, atol=0)
+        assert not a.requires_grad
+        assert a.dtype in {torch.int32, torch.int64}
+        assert a.is_contiguous()
+
+
+@pytest.mark.parametrize("dtype", [torch.int32, torch.int64])
+@pytest.mark.parametrize("resident_order", [None, (5, 2, 7, 0, 6, 1, 4, 3)])
+def test_every_bucket_matches_original_map_and_padding(dtype, resident_order):
+    order, tokens, starts, counts = _routes(
+        (1, 2, 3, 4, 5, 7, 9, 17), dtype=dtype, resident_order=resident_order
+    )
+    seen = []
+    padded = 0
+    for capacity, positions in _power_of_two_count_buckets(counts):
+        kwargs = dict(capacity=capacity, positions=positions, host_counts=counts)
+        expected = _baseline(order, tokens, starts, **kwargs)
+        actual = grouped_bucket_indices(order, tokens, starts, **kwargs)
+        _assert_maps(actual, expected)
+        seen.append(actual.real_rows)
+        padded += actual.token_rows.numel()
+    assert torch.equal(torch.cat(seen).sort().values, torch.arange(tokens.numel(), dtype=dtype))
+    assert padded < 2 * tokens.numel()
+
+
+def test_padding_at_end_of_global_pairs_repeats_last_pair():
+    order, tokens, starts, counts = _routes((1, 9))
+    maps = grouped_bucket_indices(
+        order, tokens, starts, capacity=16, positions=(1,), host_counts=counts
+    )
+    assert torch.equal(maps.token_rows[0, 9:], tokens[order[-1]].expand(7))
+    assert maps.real_rows.numel() == 9
+
+
+def test_strided_indices_use_safe_fallback():
+    order, tokens, starts, counts = _routes((3, 4, 3))
+
+    def strided(tensor):
+        backing = tensor.new_empty(tensor.numel() * 2)
+        backing[::2] = tensor
+        return backing[::2]
+
+    order, tokens, starts = map(strided, (order, tokens, starts))
+    kwargs = dict(capacity=4, positions=(2, 0, 1), host_counts=counts)
+    _assert_maps(
+        grouped_bucket_indices(order, tokens, starts, **kwargs),
+        _baseline(order, tokens, starts, **kwargs),
+    )
+
+
+def _execute(make_maps, leaves, routes):
+    x, gate, up, down, weights = leaves
+    order, token_index, starts, counts = routes
+    rows, values = [], []
+    for capacity, positions in _power_of_two_count_buckets(counts):
+        maps = make_maps(
+            order, token_index, starts,
+            capacity=capacity, positions=positions, host_counts=counts,
+        )
+        inputs = x[maps.token_rows]
+        hidden = F.silu(torch.bmm(inputs, gate.index_select(0, maps.group_positions)))
+        hidden = hidden * torch.bmm(inputs, up.index_select(0, maps.group_positions))
+        outputs = torch.bmm(hidden, down.index_select(0, maps.group_positions))
+        real_outputs = outputs.reshape(-1, x.shape[-1]).index_select(0, maps.real_slots)
+        rows.append(maps.real_rows)
+        values.append(
+            real_outputs.to(x.dtype)
+            * weights.index_select(0, maps.real_rows).to(x.dtype).unsqueeze(-1)
+        )
+    return x.new_zeros(x.shape).index_add(
+        0, token_index.index_select(0, torch.cat(rows)), torch.cat(values)
+    )
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+def test_floating_execution_and_all_gradients_are_unchanged(dtype):
+    routes = _routes((1, 3, 5, 4, 7))
+    generator = torch.Generator().manual_seed(67)
+    shapes = [(11, 8), (5, 8, 4), (5, 8, 4), (5, 4, 8), (20,)]
+    leaves = [
+        torch.randn(shape, generator=generator, dtype=dtype if i < 4 else torch.float32)
+        for i, shape in enumerate(shapes)
+    ]
+    # There are 20 routing pairs, many of which select the same input token.
+    actual_leaves = [tensor.clone().requires_grad_() for tensor in leaves]
+    expected_leaves = [tensor.clone().requires_grad_() for tensor in leaves]
+    actual = _execute(grouped_bucket_indices, actual_leaves, routes)
+    expected = _execute(_baseline, expected_leaves, routes)
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    grad = torch.randn(actual.shape, generator=generator, dtype=dtype)
+    actual.backward(grad)
+    expected.backward(grad)
+    for a, b in zip(actual_leaves, expected_leaves, strict=True):
+        torch.testing.assert_close(a.grad, b.grad, rtol=0, atol=0)
+    assert actual_leaves[-1].grad.dtype == torch.float32
+
