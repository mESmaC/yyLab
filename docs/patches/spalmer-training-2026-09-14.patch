+@pytest.mark.parametrize("rows", [1, 3, 127, 128, 129, 256])
+def test_padding_preserves_outputs_and_gradients(rows):
+    x = torch.randn(rows, 128, requires_grad=True)
+    w = torch.randn(128, 128, requires_grad=True)
+    padded, actual = standard._pad_token_rows(x)
+    assert actual == rows and padded.shape == (((rows + 127) // 128) * 128, 128)
+    assert torch.count_nonzero(padded[rows:]) == 0
+    y = (padded @ w)[:rows]
+    gradient = torch.randn_like(y)
+    y.backward(gradient)
+    torch.testing.assert_close(y, x.detach() @ w.detach())
+    torch.testing.assert_close(x.grad, gradient @ w.detach().t())
+    torch.testing.assert_close(w.grad, x.detach().t() @ gradient)
+
+
+def test_context_nested_same_device_and_exception_cleanup(monkeypatch):
+    import spalmer.experts.nvfp4_sm120 as compatibility
+
+    calls = []
+
+    @contextmanager
+    def fake_context():
+        calls.append("enter")
+        try:
+            yield {"test": True}
+        finally:
+            calls.append("exit")
+
+    monkeypatch.setattr(standard, "_resolve_cuda", lambda device: torch.device("cuda", 0))
+    monkeypatch.setattr(torch.cuda, "get_device_capability", lambda device: (12, 0))
+    monkeypatch.setattr(torch.cuda, "device", lambda device: nullcontext())
+    monkeypatch.setattr(compatibility, "nvfp4_sm120_compatibility", fake_context)
+    with pytest.raises(ValueError, match="test failure"):
+        with standard.standard_nvfp4_execution("cuda:0") as receipt:
+            with standard.standard_nvfp4_execution("cuda") as nested:
+                assert nested is receipt and calls == ["enter"]
+            with pytest.raises(RuntimeError, match="same CUDA device"):
+                with standard.standard_nvfp4_execution("cuda:1"):
+                    pass
+            raise ValueError("test failure")
+    assert calls == ["enter", "exit"] and not hasattr(standard._EXECUTION, "device")
+
+
+def test_backward_context_escape_and_cpu_execution_fail_closed():
+    x = torch.ones(1, requires_grad=True)
+    session = standard._ExecutionSession(torch.device("cpu"))
+    guarded = standard._ExecutionGuard.apply(x, session)
+    session.active = False
+    with pytest.raises(RuntimeError, match="enclosing"):
+        guarded.sum().backward()
+    assert x.grad is None
+    with pytest.raises(RuntimeError, match="CUDA"):
+        standard.standard_nvfp4_matmul(
+            torch.zeros(1, 128), torch.zeros(128, 128),
+            sr_seed=torch.tensor([1]), sign_vector=(1,) * 16,
+        )
+
+
+def test_backward_worker_uses_captured_live_session_not_thread_local():
+    x = torch.ones(3, requires_grad=True)
+    session = standard._ExecutionSession(torch.device("cpu"))
+    standard._EXECUTION.device = session.device
+    standard._EXECUTION.session = session
+    errors = []
+    worker_context = []
+    try:
+        guarded = standard._ExecutionGuard.apply(x, standard._require_execution(x.device))
+
+        def backward():
+            try:
+                worker_context.append(getattr(standard._EXECUTION, "device", None))
+                (guarded * 3).sum().backward()
+            except Exception as error:
+                errors.append(error)
+
+        worker = threading.Thread(target=backward)
+        worker.start()
+        worker.join(timeout=10)
+        assert not worker.is_alive() and not errors
+        assert worker_context == [None]
+        assert torch.equal(x.grad, torch.full_like(x, 3))
+    finally:
+        session.active = False
+        del standard._EXECUTION.device
+        del standard._EXECUTION.session
+
+
+def test_persistent_state_roundtrip_and_control_rng():
+    torch.manual_seed(412)
+    native = MicroExpertBank(config())
+    next_native = torch.rand(4)
+    torch.manual_seed(412)
+    control = MicroExpertBank(config("bfloat16"))
+    next_control = torch.rand(4)
+    for name in ("gate_proj", "up_proj", "down_proj"):
+        assert torch.equal(getattr(native, name), getattr(control, name))
+    assert torch.equal(next_native, next_control)
+    restored = MicroExpertBank(config())
+    restored.load_state_dict(native.state_dict())
+    assert restored._nvfp4_sign_vectors == native._nvfp4_sign_vectors
+    assert torch.equal(restored._nvfp4_sr_seeds, native._nvfp4_sr_seeds)
+    assert restored._nvfp4_sr_seeds.dtype == torch.int64
+    assert restored._nvfp4_rht_signs.dtype == torch.int8
+    assert all(p.dtype == torch.float32 for p in restored.parameters())
+    assert set(restored.state_dict()) == {
+        "gate_proj", "up_proj", "down_proj", "_nvfp4_sr_seeds", "_nvfp4_rht_signs",
+    }
+    with torch.device("meta"):
+        meta = MicroExpertBank(config())
+    assert meta._nvfp4_sr_seeds.device.type == "meta"
+    assert len(meta._nvfp4_sign_vectors) == 3
