+def _needs_head_alignment(q: torch.Tensor, k: torch.Tensor, v: torch.Tensor) -> bool:
+    """Enable native SDPA's aligned small-head paths without a device query."""
+
+    return (
+        q.device.type == "cuda"
+        and q.device == k.device == v.device
+        and q.dtype in {torch.bfloat16, torch.float16}
+        and q.dtype == k.dtype == v.dtype
+        and q.shape[-1] == k.shape[-1]
+        and 0 < q.shape[-1] <= 256
+        and 0 < v.shape[-1] <= 256
+        and (q.shape[-1] % 8 != 0 or v.shape[-1] % 8 != 0)
+    )
+
+
+def _pad_sdpa_heads(
+    q: torch.Tensor, k: torch.Tensor, v: torch.Tensor
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, float]:
+    """Zero-pad head coordinates while retaining the original score scale.
+
+    Padding changes only the temporary SDPA operands. It introduces neither
+    parameters nor cache entries, and gradients through the added zeros are
+    discarded by ordinary pad/slice autograd. The helper is device-independent
+    so its mathematical equivalence can also be checked with FP64 on CPU.
+    """
+
+    key_padding = -q.shape[-1] % 8
+    value_padding = -v.shape[-1] % 8
+    scale = q.shape[-1] ** -0.5
+    if key_padding:
+        q = F.pad(q, (0, key_padding))
+        k = F.pad(k, (0, key_padding))
+    if value_padding:
+        v = F.pad(v, (0, value_padding))
+    return q, k, v, scale
+
