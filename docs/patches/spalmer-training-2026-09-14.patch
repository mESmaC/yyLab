index 0000000000000000000000000000000000000000..c345fb27eaca5c6fdefe8f23070d86e772a1a428
--- /dev/null
+++ b/src/spalmer/experts/nvfp4_sm120.py
@@ -0,0 +1,244 @@
+"""Explicit, experimental SM120 stochastic-rounding compatibility for TorchAO.
+
+Only the unsupported FP4 SR conversion is replaced. RHT, scales, Philox streams,
+packed FP4 GEMMs and the optimizer stay with the installed upstream recipe.
+The arithmetic is independently expressed from the E2M1 grid; the dither and
+lane arrangement follow Harry Chen's Apache-2.0 published SM120 polyfill:
+https://github.com/Harry-Chen/fp4_sm120/blob/master/stochastic_rounding/sr.sm120.cuh
+Scoped attribution/license: third_party/licenses/harry-chen-fp4-sm120/NOTICE.md
+
+This is 8-bit stochastic dither followed by native nearest-even conversion.
+Its marginal rounding probability approximates ideal SR within 1/256. We do
+not claim bit identity with SM100: the published polyfill's random-byte mapping
+has not been independently compared with that hardware here.
+
+The context modifies a process-global JIT helper. Use it exclusively around all
+eager forward/backward work; concurrent upstream calls and graphs escaping the
+context are unsupported. No installed file is modified. JIT/dispatch caches are
+isolated and restored so compiled compatibility code cannot leak after exit.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib
+import math
+import struct
+import threading
+from collections import defaultdict
+from contextlib import contextmanager
+from pathlib import Path
+
+try:
+    import triton
+    import triton.language as tl
+except ImportError:
+    triton = None
+    tl = None
+
+_LEVELS = (0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0)
+_CONTEXT_LOCK = threading.Lock()
+_MISSING_ATTRIBUTE = object()
+
+
+def _restore_snapshots(snapshots):
+    for owner, attr, value in reversed(snapshots):
+        if value is _MISSING_ATTRIBUTE:
+            if hasattr(owner, attr):
+                delattr(owner, attr)
+        else:
+            setattr(owner, attr, value)
+    snapshots.clear()
+
+
+def _fp32(value: float) -> float:
+    return struct.unpack("<f", struct.pack("<f", value))[0]
+
+
+def e2m1_sr_reference(value: float, random_byte: int) -> int:
+    """Scalar CPU oracle: finite grid/bracket lookup, FP32 dither and RN-even."""
+    if not 0 <= random_byte <= 255:
+        raise ValueError("random_byte must be in [0, 255]")
+    value = _fp32(value)
+    if math.isnan(value):
+        return 7  # PTX satfinite maps even negative NaNs to positive MAX_NORM.
+    sign = 8 if math.copysign(1.0, value) < 0 else 0
+    magnitude = abs(value)
+    if magnitude >= 6:
+        return sign | 7
+    lower = max(level for level in _LEVELS if level <= magnitude)
+    width = 0.5 if magnitude < 2 else (1.0 if magnitude < 4 else 2.0)
+    noise = _fp32(_fp32((random_byte - 127.5) / 256) * width)
+    perturbed = max(lower, _fp32(magnitude + noise))
+    code = min(range(8), key=lambda i: (abs(_LEVELS[i] - perturbed), i % 2))
+    return sign | code
+
+
+def pack_fp4_sr_reference(values, random_bits) -> list[int]:
+    """CPU oracle of the upstream eight-value/two-used-random-word arrangement.
+
+    There are four random words per eight values, as in the upstream pack=4
+    inline assembly; only the first two words of each group are consumed.
+    """
+    if not values or len(values) % 8 or len(random_bits) != len(values) // 2:
+        raise ValueError("need a positive multiple of eight values and half as many random words")
+    output = []
+    for pair in range(len(values) // 2):
+        word_index = (pair // 4) * 4 + (pair % 4) // 2
+        word = int(random_bits[word_index]) & 0xFFFFFFFF
+        shift = 24 if pair % 2 == 0 else 8
+        low = e2m1_sr_reference(values[2 * pair], (word >> shift) & 255)
+        high = e2m1_sr_reference(values[2 * pair + 1], (word >> (shift - 8)) & 255)
+        output.append(low | (high << 4))
+    return output
+
+
+if triton is not None:
+
+    @triton.jit
+    def _dither_e2m1(value, random_byte):
+        raw = value.to(tl.uint32, bitcast=True)
+        magnitude_bits = raw & 0x7FFFFFFF
+        magnitude = magnitude_bits.to(tl.float32, bitcast=True)
+        exponent = magnitude_bits >> 23
+        spacing_exp = tl.minimum(tl.maximum(exponent, 127), 129) - 1
+        spacing = (spacing_exp << 23).to(tl.float32, bitcast=True)
+        floor_normal = (magnitude_bits & 0xFFC00000).to(tl.float32, bitcast=True)
+        floor_small = tl.where(exponent >= 126, 0.5, 0.0)
+        floor_value = tl.where(exponent >= 127, floor_normal, floor_small)
+        offset = (random_byte.to(tl.float32) - 127.5) * 0.00390625
+        noise = offset * spacing
+        # The noise uses exact power-of-two products; this addition rounds to FP32.
+        noisy = tl.add(magnitude, noise)
+        rounded_input = tl.maximum(noisy, floor_value)
+        signed_bits = rounded_input.to(tl.uint32, bitcast=True) | (raw & 0x80000000)
+        result = signed_bits.to(tl.float32, bitcast=True)
+        return tl.where(magnitude_bits > 0x7F800000, 6.0, result)
+
+    @triton.jit
+    def _convert_fp4_sr_sm120(x_pairs, rbits):
+        groups: tl.constexpr = rbits.numel // 4
+        lane = tl.arange(0, 4)
+        selected = tl.gather(
+            rbits.reshape((groups, 4)),
+            tl.broadcast_to((lane // 2)[None, :], (groups, 4)),
+            axis=1,
+        ).reshape(rbits.shape)
+        shifts = tl.broadcast_to((24 - 16 * (lane % 2))[None, :], (groups, 4))
+        shifts = shifts.reshape(rbits.shape)
+        low = _dither_e2m1(x_pairs[0], (selected >> shifts) & 255)
+        high = _dither_e2m1(x_pairs[1], (selected >> (shifts - 8)) & 255)
+        # Same pair/nibble order as TorchAO's native round-to-nearest helper.
+        return tl.inline_asm_elementwise(
+            asm="""{
+                .reg .b8 b0, b1, b2, b3;
+                cvt.rn.satfinite.e2m1x2.f32 b0, $5, $1;
+                cvt.rn.satfinite.e2m1x2.f32 b1, $6, $2;
+                cvt.rn.satfinite.e2m1x2.f32 b2, $7, $3;
+                cvt.rn.satfinite.e2m1x2.f32 b3, $8, $4;
+                mov.b32 $0, {b0, b1, b2, b3};
+            }""",
+            constraints="=r,r,r,r,r,r,r,r,r",
+            args=[low, high], dtype=tl.uint8, is_pure=True, pack=4,
+        )
+
+    @triton.jit
+    def _probe_pack_kernel(values, random_bits, result, PAIRS, BLOCK: tl.constexpr):
+        pair = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+        low = tl.load(values + 2 * pair, pair < PAIRS, other=0.0)
+        high = tl.load(values + 2 * pair + 1, pair < PAIRS, other=0.0)
+        random = tl.load(random_bits + pair, pair < PAIRS, other=0)
+        packed = _convert_fp4_sr_sm120((low, high), random)
+        tl.store(result + pair, packed, pair < PAIRS)
+
+
+def pack_fp4_sr_cuda(values, random_bits):
+    """Standalone native conversion probe; validation is metadata-only."""
+    import torch
+
+    if triton is None:
+        raise RuntimeError("Triton is required")
+    if values.device.type != "cuda" or values.device != random_bits.device:
+        raise ValueError("inputs must share a CUDA device")
+    if values.dtype != torch.float32 or random_bits.dtype != torch.uint32:
+        raise ValueError("values/random bits must be FP32/uint32")
+    if values.ndim != 1 or random_bits.ndim != 1:
+        raise ValueError("inputs must be one-dimensional")
+    if not values.is_contiguous() or not random_bits.is_contiguous():
+        raise ValueError("inputs must be contiguous")
+    if not values.numel() or values.numel() % 8 or random_bits.numel() * 2 != values.numel():
+        raise ValueError("need a positive multiple of eight values and half as many random words")
+    output = torch.empty(random_bits.shape, dtype=torch.uint8, device=values.device)
+    _probe_pack_kernel[(triton.cdiv(output.numel(), 256),)](
+        values, random_bits, output, output.numel(), BLOCK=256, enable_fp_fusion=False,
+    )
+    return output
+
+
+@contextmanager
+def nvfp4_sm120_compatibility():
+    """Temporarily replace one JIT conversion for explicit eager CUDA use.
+
+    Explicit opt-in only. Callers verify their hardware separately. The installed
+    TorchAO 0.18/Triton 3.7 object layout is checked before any mutation.
+    Upstream imports can query CUDA availability/capability. CPU definition tests
+    stub those hardware dependencies; this context alone is not a CPU-only guard.
+    """
+    if triton is None:
+        raise RuntimeError("Triton is required")
+    if not _CONTEXT_LOCK.acquire(blocking=False):
+        raise RuntimeError("NVFP4 compatibility contexts cannot overlap")
+    snapshots = []
+    original = None
+    module = None
+    try:
+        prefix = "torchao.prototype.moe_training.nvfp4_training."
+        module = importlib.import_module(prefix + "hadamard_utils")
+        quantizer = importlib.import_module(prefix + "hadamard_quantize_row_col_triton")
+        original = module.convert_8xfp32_to_4xfp4_packed_rs
+        tuner = quantizer._hadamard_quantize_row_col_kernel
+        jit_functions = (module._pack_fp4, tuner.fn)
+        if "cvt.rs.satfinite.e2m1x4.f32" not in original.src:
+            raise RuntimeError("Unexpected upstream SR helper; compatibility needs a new review")
