index 0000000000000000000000000000000000000000..37cecab1a318ed246dd65b0955e4009cb77a2cb1
--- /dev/null
+++ b/src/spalmer/experts/grouped_packing.py
@@ -0,0 +1,207 @@
+"""Integer-only packing maps for the ordinary grouped BF16/FP32 executor.
+
+The CUDA path fuses routing-index construction, never floating-point work.
+Activation gathers and their existing PyTorch backward reductions stay with
+the caller. In particular, padded slots retain the original global clamp
+behavior; they are not zeroed or assigned to a different routing pair.
+
+Inputs are the trusted route plan already built by ``MicroExpertBank``. Tensor
+contents are not read back for validation. ``host_counts`` must describe the
+same positive groups as ``group_starts`` and ``order`` must be a valid stable
+permutation of the routing pairs. CPU, strided tensors, or missing Triton use
+the ordinary Torch reference path. No CUDA capability query runs on import.
+"""
+
+from __future__ import annotations
+
+import operator
+import os
+from collections.abc import Sequence
+from typing import Literal, NamedTuple
+
+import torch
+from torch import Tensor
+
+try:
+    import triton
+    import triton.language as tl
+except ImportError:
+    triton = None
+    tl = None
+
+
+class GroupedBucketIndices(NamedTuple):
+    """Maps in the same bucket/group/slot order as the grouped executor."""
+
+    group_positions: Tensor
+    token_rows: Tensor
+    real_rows: Tensor
+    real_slots: Tensor
+
+
+if triton is not None:
+
+    @triton.jit(do_not_specialize=["num_pairs", "num_slots", "num_groups"])
+    def _bucket_indices_kernel(
+        Order,
+        Tokens,
+        Starts,
+        Plan,
+        TokenRows,
+        RealRows,
+        RealSlots,
+        num_pairs,
+        num_slots,
+        num_groups,
+        CAPACITY: tl.constexpr,
+        BLOCK: tl.constexpr,
+    ):
+        linear = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+        valid = linear < num_slots
+        group = linear // CAPACITY
+        slot = linear % CAPACITY
+        position = tl.load(Plan + group, valid, other=0)
+        count = tl.load(Plan + num_groups + group, valid, other=0)
+        compact_start = tl.load(Plan + 2 * num_groups + group, valid, other=0)
+        start = tl.load(Starts + position, valid, other=0).to(tl.int64)
+        # Match the old clamp_max across the complete sorted pair list, even
+        # when a padded slot consequently reads another expert's real pair.
+        sorted_pair = tl.minimum(start + slot, num_pairs - 1)
+        pair = tl.load(Order + sorted_pair, valid, other=0).to(tl.int64)
+        token = tl.load(Tokens + pair, valid, other=0)
+        tl.store(TokenRows + linear, token, valid)
+        real = valid & (slot < count)
+        compact = compact_start + slot
+        # Positive counts and disjoint host prefix offsets give each compact
+        # output exactly one writer. No atomics or floating reductions occur.
+        tl.store(RealRows + compact, pair, real)
+        tl.store(RealSlots + compact, linear, real)
+
+
+def _torch_indices(
+    order: Tensor,
+    token_index: Tensor,
+    group_starts: Tensor,
+    plan: Tensor,
+    capacity: int,
+    real_count: int,
+) -> GroupedBucketIndices:
+    positions, counts, offsets = plan.unbind(0)
+    starts = group_starts.index_select(0, positions)
+    slot = torch.arange(capacity, device=order.device)
+    gather = (starts[:, None] + slot[None, :]).clamp_max(order.numel() - 1)
+    pair_rows = order[gather]
+    token_rows = token_index[pair_rows]
+    groups = torch.repeat_interleave(
+        torch.arange(positions.numel(), device=order.device),
+        counts,
+        output_size=real_count,
+    )
+    real_slots = (
+        groups * capacity
+        + torch.arange(real_count, device=order.device)
+        - offsets.index_select(0, groups)
+    )
+    real_rows = pair_rows.reshape(-1).index_select(0, real_slots)
+    return GroupedBucketIndices(positions, token_rows, real_rows, real_slots)
+
+
+def grouped_bucket_indices(
+    order: Tensor,
+    token_index: Tensor,
+    group_starts: Tensor,
+    *,
+    capacity: int,
+    positions: Sequence[int],
+    host_counts: Sequence[int],
+    backend: Literal["auto", "torch", "triton"] = "auto",
+) -> GroupedBucketIndices:
+    """Build padded input rows and compact output maps for one count bucket.
+
+    ``positions`` indexes ``group_starts`` and ``host_counts`` in the caller's
+    chosen group order. ``host_counts`` is the existing host count readback,
+    not a new synchronization. All returned maps are integer tensors on the
+    input device. For a bucket with G groups, capacity C and R real pairs,
+    persistent map storage is G + G*C + 2*R integer elements; the positions
+    view also keeps a tiny 3*G-element plan alive. No padded activation or
+    floating-point intermediate is allocated here.
+
+    Explicit ``triton`` is intended for opt-in validation and requires CUDA
+    (or an explicitly enabled Triton interpreter). ``auto`` selects Triton
+    only for contiguous CUDA int64/int32 inputs. Launch errors propagate;
+    they are not concealed by retrying a potentially asynchronous failure.
+    """
+
+    if backend not in {"auto", "torch", "triton"}:
+        raise ValueError(f"unknown grouped packing backend: {backend!r}")
+    capacity = operator.index(capacity)
+    if capacity < 1 or capacity & (capacity - 1):
+        raise ValueError("bucket capacity must be a positive power of two")
+    tensors = (order, token_index, group_starts)
+    if any(t.ndim != 1 or t.dtype not in {torch.int32, torch.int64} for t in tensors):
+        raise ValueError("route indices must be rank-one int32/int64 tensors")
+    if any(t.device != order.device for t in tensors):
+        raise ValueError("route indices must share one device")
+    if order.numel() != token_index.numel():
+        raise ValueError("order and token_index must describe the same number of pairs")
+    if len(host_counts) != group_starts.numel():
+        raise ValueError("host_counts must describe every group start")
+    selected = tuple(operator.index(position) for position in positions)
+    if len(set(selected)) != len(selected):
+        raise ValueError("bucket group positions must be unique")
+    if any(position < 0 or position >= len(host_counts) for position in selected):
+        raise ValueError("bucket group position is out of range")
+    counts = tuple(operator.index(host_counts[position]) for position in selected)
+    if any(count < 1 or count > capacity or capacity >= 2 * count for count in counts):
+        raise ValueError("group counts must occupy their smallest power-of-two bucket")
+    if selected and order.numel() == 0:
+        raise ValueError("a nonempty bucket requires routing pairs")
+    offsets: list[int] = []
+    real_count = 0
+    for count in counts:
+        offsets.append(real_count)
+        real_count += count
+    # One tiny host-to-device copy replaces the old group_positions upload.
+    # All three rows are contiguous, including the returned weight-gather ids.
+    plan = torch.tensor((selected, counts, offsets), dtype=torch.long, device=order.device)
+    if not selected:
+        return GroupedBucketIndices(
+            plan[0],
+            token_index.new_empty((0, capacity)),
+            order.new_empty((0,)),
+            plan.new_empty((0,)),
+        )
+
+    contiguous = all(t.is_contiguous() for t in tensors)
+    native_available = triton is not None and contiguous and order.device.type == "cuda"
+    if backend == "triton" and not native_available:
+        # Interpreter execution is an explicit developer/test opt-in only.
+        interpreter = triton is not None and os.environ.get("TRITON_INTERPRET") == "1"
+        if not (interpreter and contiguous and order.device.type == "cpu"):
+            raise RuntimeError("Triton packing requires contiguous CUDA indices and Triton")
+    if backend == "torch" or (backend == "auto" and not native_available):
+        return _torch_indices(order, token_index, group_starts, plan, capacity, real_count)
+
+    num_slots = len(selected) * capacity
+    token_rows = token_index.new_empty((len(selected), capacity))
+    real_rows = order.new_empty((real_count,))
+    real_slots = plan.new_empty((real_count,))
+    _bucket_indices_kernel[(triton.cdiv(num_slots, 256),)](
+        order,
+        token_index,
+        group_starts,
+        plan,
+        token_rows,
+        real_rows,
+        real_slots,
+        order.numel(),
+        num_slots,
+        len(selected),
+        capacity,
+        256,
+        num_warps=4,
+    )
+    return GroupedBucketIndices(plan[0], token_rows, real_rows, real_slots)
+
+
+__all__ = ["GroupedBucketIndices", "grouped_bucket_indices"]
