+"""Exact clipping parity with the sequential training-engine contract."""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+import torch
+from torch import Tensor, nn
+
+from spalmer.training.engine import _clip_gradients
+
+
+def _parameters(gradients: list[Tensor | None]) -> tuple[nn.Parameter, ...]:
+    parameters = []
+    for gradient in gradients:
+        parameter = nn.Parameter(
+            torch.empty(gradient.shape, dtype=gradient.dtype, device=gradient.device)
+            if gradient is not None
+            else torch.empty(3)
+        )
+        parameter.grad = gradient
+        parameters.append(parameter)
+    return tuple(parameters)
+
+
+def _sequential_clip(parameters: tuple[nn.Parameter, ...], maximum: float) -> float:
+    # Frozen pre-batching behavior: preserve FP32 per-tensor reduction order,
+    # sparse coalescing, and the BF16 rounding of the scale itself.
+    dense = [p.grad for p in parameters if p.grad is not None and not p.grad.is_sparse]
+    sparse = []
+    for parameter in parameters:
+        if parameter.grad is not None and parameter.grad.is_sparse:
+            parameter.grad = parameter.grad.coalesce()
+            sparse.append(parameter.grad.values())
+    squared = torch.zeros((), dtype=torch.float32, device=parameters[0].device)
+    for values in [*dense, *sparse]:
+        squared.add_(values.detach().float().square().sum())
+    norm = squared.sqrt()
+    scale = (maximum / (norm + 1e-6)).clamp(max=1.0)
+    for values in [*dense, *sparse]:
+        values.mul_(scale.to(values.dtype))
+    return float(norm)
+
+
+def _assert_equal_gradients(actual, expected) -> None:
+    for observed, reference in zip(actual, expected, strict=True):
+        if reference.grad is None:
+            assert observed.grad is None
+            continue
+        left, right = observed.grad, reference.grad
+        if right.is_sparse:
+            assert left.is_coalesced() == right.is_coalesced()
+            assert torch.equal(left.indices(), right.indices())
+            left, right = left.values(), right.values()
+        assert left.dtype == right.dtype
+        assert torch.equal(
+            left.contiguous().reshape(-1).view(torch.uint8),
+            right.contiguous().reshape(-1).view(torch.uint8),
+        )
+
+
+@pytest.mark.parametrize(
+    "device",
+    [
+        "cpu",
+        pytest.param(
+            "cuda",
+            marks=pytest.mark.skipif(
+                os.environ.get("SPALMER_TEST_CUDA") != "1", reason="explicit CUDA opt-in required"
+            ),
+        ),
+    ],
+)
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16, torch.float32, torch.float64])
+@pytest.mark.parametrize("maximum", [0.0, 0.0314159, 1e10])
+def test_batched_clipping_matches_sequential_bits_and_rng(device, dtype, maximum) -> None:
+    generator = torch.Generator(device="cpu").manual_seed(27)
+    gradients = [
+        torch.randn(shape, generator=generator).to(device=device, dtype=dtype)
+        for shape in [(1,), (17,), (3, 11), (4097,), (0,), ()]
+    ]
+    actual = _parameters([*gradients, None])
+    expected = _parameters([*(gradient.clone() for gradient in gradients), None])
+    rng_before = torch.random.get_rng_state()
+    cuda_rng_before = torch.cuda.get_rng_state() if device == "cuda" else None
+    assert _clip_gradients(actual, maximum) == _sequential_clip(expected, maximum)
+    assert torch.equal(torch.random.get_rng_state(), rng_before)
+    if cuda_rng_before is not None:
+        assert torch.equal(torch.cuda.get_rng_state(), cuda_rng_before)
+    _assert_equal_gradients(actual, expected)
+
+
+def test_mixed_dtypes_share_one_typed_scale_per_foreach_group(monkeypatch) -> None:
+    gradients = [
+        torch.tensor([1.0, -3.5, 0.125], dtype=dtype)
+        for dtype in [torch.bfloat16, torch.float32, torch.bfloat16, torch.float32]
+    ]
+    actual = _parameters(gradients)
+    expected = _parameters([gradient.clone() for gradient in gradients])
+    calls = []
+    original = torch._foreach_mul_
+
+    def record(values, scale):
+        calls.append((len(values), tuple(value.dtype for value in values), scale.dtype))
+        return original(values, scale)
+
+    monkeypatch.setattr(torch, "_foreach_mul_", record)
+    assert _clip_gradients(actual, 0.73) == _sequential_clip(expected, 0.73)
+    assert calls == [
+        (2, (torch.bfloat16, torch.bfloat16), torch.bfloat16),
+        (2, (torch.float32, torch.float32), torch.float32),
+    ]
+    _assert_equal_gradients(actual, expected)
+
+
+def test_sparse_duplicate_indices_keep_coalescing_and_scaling_behavior() -> None:
+    sparse = torch.sparse_coo_tensor(
+        torch.tensor([[2, 0, 2]]),
+        torch.tensor([[1.5, -3.0], [2.0, 0.5], [-0.25, 1.0]]),
+        size=(4, 2),
+        check_invariants=True,
+    )
+    gradients = [torch.tensor([2.0, -4.0]), sparse, torch.tensor([0.5]), None]
+    actual = _parameters(gradients)
+    expected = _parameters([g.clone() if g is not None else None for g in gradients])
+    assert _clip_gradients(actual, 0.4) == _sequential_clip(expected, 0.4)
+    _assert_equal_gradients(actual, expected)
+
+
+@pytest.mark.parametrize("fallback", ["missing_foreach", "noncontiguous", "aliased"])
+def test_sequential_fallback_preserves_exact_writes(monkeypatch, fallback) -> None:
+    values = torch.arange(1.0, 13.0).reshape(3, 4)
+    expected_values = values.clone()
+    if fallback == "noncontiguous":
+        gradients = [values.t(), torch.tensor([0.75])]
+        expected_gradients = [expected_values.t(), torch.tensor([0.75])]
+    elif fallback == "aliased":
+        gradients = [values.reshape(-1)[:8], values.reshape(-1)[4:]]
+        expected_gradients = [expected_values.reshape(-1)[:8], expected_values.reshape(-1)[4:]]
+    else:
+        gradients = [values, torch.tensor([0.75])]
+        expected_gradients = [expected_values, torch.tensor([0.75])]
+    actual, expected = _parameters(gradients), _parameters(expected_gradients)
+
+    def unexpected_foreach(*args):
+        raise AssertionError("unsupported/aliased tensors must retain sequential writes")
+
+    monkeypatch.setattr(
+        torch, "_foreach_mul_", None if fallback == "missing_foreach" else unexpected_foreach
+    )
+    assert _clip_gradients(actual, 0.3) == _sequential_clip(expected, 0.3)
+    _assert_equal_gradients(actual, expected)
+
+
+def test_disabled_clipping_and_missing_gradients_are_unchanged() -> None:
+    gradient = torch.tensor([2.0, 3.0])
+    parameters = _parameters([gradient, None])
+    before = gradient.clone()
+    assert _clip_gradients(parameters, None) is None
+    assert torch.equal(gradient, before)
+    assert _clip_gradients(_parameters([None, None]), 1.0) == 0.0
