+@pytest.mark.skipif(os.environ.get("SPALMER_TEST_CUDA") != "1", reason="explicit CUDA opt-in")
+def test_cuda_mapping_against_independent_cpu_oracle():
+    import torch
+
+    from spalmer.experts.nvfp4_sm120 import pack_fp4_sr_cuda
+
+    rng = random.Random(89)
+    values = [rng.uniform(-7, 7) for _ in range(2048)]
+    values += [0.0, -0.0, math.inf, -math.inf, math.nan, -math.nan, 2.0, 4.0]
+    words = [rng.getrandbits(32) for _ in range(len(values) // 2)]
+    cpu_values = torch.tensor(values, dtype=torch.float32)
+    expected = pack_fp4_sr_reference(cpu_values.tolist(), words)
+    actual = pack_fp4_sr_cuda(
+        cpu_values.cuda(), torch.tensor(words, dtype=torch.uint32, device="cuda")
+    )
+    assert actual.cpu().tolist() == expected
