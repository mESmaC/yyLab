new file mode 100644
index 0000000000000000000000000000000000000000..fcc04fc6cf8d7e4cf6fbe716e02643ed872c8dd6
--- /dev/null
+++ b/tests/training/test_rounding.py
@@ -0,0 +1,246 @@
+"""Exact output bits and RNG consumption for isolated BF16 rounding."""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+import torch
+
+from spalmer.training import rounding
+
+
+def original_round(values):
+    """Frozen pre-fusion optimizer formula, independent of either runtime path.
+
+    Copied from runs/mla-speed-2026-09-07/optim-baseline.py. Keep this literal
+    oracle in the tests even after the optimizer delegates to the native path.
+    """
+
+    maximum = torch.finfo(torch.bfloat16).max
+    bounded = values.clamp(min=-maximum, max=maximum)
+    nearest = bounded.to(torch.bfloat16)
+    nearest_fp32 = nearest.float()
+    negative_infinity = torch.full_like(nearest, float("-inf"))
+    positive_infinity = torch.full_like(nearest, float("inf"))
+    lower = torch.where(
+        nearest_fp32 > bounded,
+        torch.nextafter(nearest, negative_infinity),
+        nearest,
+    )
+    upper = torch.where(
+        nearest_fp32 < bounded,
+        torch.nextafter(nearest, positive_infinity),
+        nearest,
+    )
+    lower_fp32 = lower.float()
+    upper_fp32 = upper.float()
+    span = upper_fp32 - lower_fp32
+    probability_upper = torch.where(
+        span > 0,
+        ((bounded - lower_fp32) / span).clamp(0.0, 1.0),
+        torch.zeros_like(bounded),
+    )
+    rounded = torch.where(torch.rand_like(probability_upper) < probability_upper, upper, lower)
+    return torch.where(torch.isfinite(values), rounded, values.to(torch.bfloat16))
+
+
+def _bits(values):
+    canonical = values.detach().clone(memory_format=torch.contiguous_format)
+    return canonical.reshape(-1).view(torch.uint8)
+
+
+def _edge_values():
+    return torch.tensor(
+        [
+            0x00000000, 0x80000000, 0x00000001, 0x80000001,
+            0x00007FFF, 0x80007FFF, 0x00008000, 0x80008000,
+            0x00008001, 0x80008001, 0x00010000, 0x80010000,
+            0x007FFFFF, 0x807FFFFF, 0x00800000, 0x80800000,
+            0x3F800000, 0xBF800000, 0x3F807FFF, 0xBF807FFF,
+            0x3F808000, 0xBF808000, 0x3F808001, 0xBF808001,
+            0x7F7EFFFF, 0xFF7EFFFF, 0x7F7F0000, 0xFF7F0000,
+            0x7F7F0001, 0xFF7F0001, 0x7F7FFFFF, 0xFF7FFFFF,
+            0x7F800000, 0xFF800000, 0x7FC00000, 0xFFC00000,
+            0x7F800001, 0xFF800001, 0x7FFFFFFF, 0xFFFFFFFF,
+            0x7FC12345, 0xFFC54321,
+        ],
+        dtype=torch.uint32,
+    ).view(torch.float32)
+
+
+def _random_bits(count):
+    generator = torch.Generator(device="cpu").manual_seed(713)
+    return torch.randint(0, 2**32, (count,), generator=generator, dtype=torch.int64).to(
+        torch.uint32
+    ).view(torch.float32)
+
+
+def _rng_state(device):
+    if device.type == "cuda":
+        return torch.cuda.get_rng_state(device)
+    return torch.random.get_rng_state()
+
+
+def _set_rng_state(state, device):
+    if device.type == "cuda":
+        torch.cuda.set_rng_state(state, device)
+    else:
+        torch.random.set_rng_state(state)
+
+
+def _compare_seeded(values, backend):
+    before_values = _bits(values).clone()
+    before = _rng_state(values.device)
+    expected = original_round(values)
+    expected_rng = _rng_state(values.device)
+    _set_rng_state(before, values.device)
+    actual = rounding.stochastic_round_bfloat16(values, backend=backend)
+    assert actual.shape == expected.shape
+    assert actual.dtype == expected.dtype == torch.bfloat16
+    assert actual.stride() == expected.stride()
+    assert torch.equal(_bits(actual), _bits(expected))
+    assert torch.equal(_rng_state(values.device), expected_rng)
+    assert torch.equal(_bits(values), before_values)
+
+
+@pytest.mark.parametrize("backend", ["auto", "torch"])
+@pytest.mark.parametrize(
+    "kind", ["edge", "random", "empty", "scalar", "strided", "float64", "singleton_stride"]
+)
+def test_cpu_fallback_exact_bits_and_rng(backend, kind):
+    if kind == "edge":
+        values = _edge_values()
+    elif kind == "random":
+        values = _random_bits(4097)
+    elif kind == "empty":
+        values = torch.empty(0, 3)
+    elif kind == "scalar":
+        values = torch.tensor(-0.0)
+    elif kind == "strided":
+        values = _random_bits(99).reshape(9, 11).t()
+    elif kind == "singleton_stride":
+        values = torch.empty_strided((1, 17), (999, 1)).fill_(0.333)
+    else:
+        values = _edge_values().double()
+    _compare_seeded(values, backend)
+
+
+def test_invalid_backend_does_not_consume_rng():
+    state = torch.random.get_rng_state()
+    with pytest.raises(ValueError, match="unknown"):
+        rounding.stochastic_round_bfloat16(torch.ones(3), backend="invalid")
+    assert torch.equal(state, torch.random.get_rng_state())
+
+
+def test_missing_triton_retains_fallback_and_explicit_rejection(monkeypatch):
+    monkeypatch.setattr(rounding, "triton", None)
+    _compare_seeded(_edge_values(), "auto")
+    state = torch.random.get_rng_state()
+    with pytest.raises(ValueError, match="contiguous FP32"):
+        rounding.stochastic_round_bfloat16(torch.ones(3), backend="triton")
+    assert torch.equal(state, torch.random.get_rng_state())
+
+
+def test_autograd_input_retains_torch_fallback():
+    values = torch.tensor([1.002, -0.333], requires_grad=True)
+    _compare_seeded(values, "auto")
+    assert rounding.stochastic_round_bfloat16(values).requires_grad
+    with pytest.raises(ValueError, match="without autograd"):
+        rounding.stochastic_round_bfloat16(values, backend="triton")
+
+
+def test_lazy_negative_view_retains_torch_fallback():
+    values = torch._neg_view(torch.tensor([0.333, -1.002], dtype=torch.float32))
+    assert values.is_neg() and values.is_contiguous()
+    assert not rounding._native_supported(values, interpreter=True)
+    _compare_seeded(values, "auto")
+    with pytest.raises(ValueError, match="contiguous FP32"):
+        rounding.stochastic_round_bfloat16(values, backend="triton")
+
+
+@pytest.mark.parametrize(
+    "shape,strides", [((1, 17), (999, 1)), ((3, 1), (1, 100)), ((1,), (17,)), ((0, 3), (99, 9))]
+)
+def test_unusual_contiguous_strides_fall_back(shape, strides):
+    values = torch.empty_strided(shape, strides).fill_(0.333)
+    assert values.is_contiguous()
+    assert not rounding._native_supported(values, interpreter=True)
+    _compare_seeded(values, "auto")
+
+
+@pytest.fixture
+def native_device():
+    if rounding.triton is None:
+        pytest.skip("Triton is not installed")
+    if os.environ.get("TRITON_INTERPRET") == "1":
+        return torch.device("cpu")
+    if os.environ.get("SPALMER_TEST_CUDA") == "1":
+        return torch.device("cuda")
+    pytest.skip("explicit CUDA or Triton interpreter opt-in required")
+
+
+@pytest.mark.parametrize("shape", [(), (0,), (1,), (17,), (513,), (9, 113)])
+def test_native_exact_bits_and_rng_for_shapes(native_device, shape):
+    count = 1
+    for size in shape:
+        count *= size
+    values = _random_bits(count).reshape(shape).to(native_device)
+    _compare_seeded(values, "triton")
+
+
+def test_native_signed_zero_subnormals_saturation_nan_bits_and_infinities(native_device):
+    _compare_seeded(_edge_values().to(native_device), "triton")
+
+
+def test_native_every_bf16_representation(native_device):
+    values = torch.arange(65536, dtype=torch.int32).to(torch.uint16).view(torch.bfloat16).float()
+    _compare_seeded(values.to(native_device), "triton")
+
+
+def test_native_all_rounding_midpoints_and_neighbors(native_device):
+    # Sweep both signs, every exponent, and every mantissa. Values immediately
+    # below/at/above an FP32-to-BF16 midpoint exercise nearest-even ties too.
+    upper_bits = torch.arange(65536, dtype=torch.int64) << 16
+    values = torch.stack([upper_bits + offset for offset in (0x7FFF, 0x8000, 0x8001)])
+    values = values.to(torch.uint32).view(torch.float32).flatten().to(native_device)
+    _compare_seeded(values, "triton")
+
+
+@pytest.mark.parametrize("draw", [0.0, 0.125, 0.25, 0.5, 0.75, 0.875, 1.0])
+def test_native_explicit_probability_boundaries(native_device, draw, monkeypatch):
+    # Exact binary fractions of a BF16 ULP, including the subnormal grid and
+    # both signed-zero neighbors. Explicit draws distinguish < from <=.
+    units = torch.tensor([2.0**-133, 2.0**-126, 2.0**-7, 1.0, 2.0**120])
+    fractions = torch.tensor([0.0, 0.125, 0.25, 0.5, 0.75, 0.875, 1.0])
+    values = (units[:, None] * fractions[None, :]).reshape(-1)
+    values = torch.cat([values, -values, _edge_values()]).to(native_device)
+    draws = torch.full_like(values, draw)
+    with monkeypatch.context() as fixed_draw:
+        fixed_draw.setattr(torch, "rand_like", lambda _template: draws)
+        expected = original_round(values)
+    actual = rounding._native_round(values, draws)
+    assert torch.equal(_bits(actual), _bits(expected))
+
+
+def test_native_keeps_one_identical_rand_like_request(native_device, monkeypatch):
+    values = _random_bits(513).to(native_device)
+    calls = []
+    original = torch.rand_like
+
+    def record(tensor, *args, **kwargs):
+        calls.append((tensor.shape, tensor.stride(), tensor.dtype, tensor.device))
+        return original(tensor, *args, **kwargs)
+
+    monkeypatch.setattr(torch, "rand_like", record)
+    _compare_seeded(values, "triton")
+    assert len(calls) == 2  # one reference call, one native call
+    assert calls[0] == calls[1]
+
+
+def test_native_rejects_strided_values_without_consuming_rng(native_device):
+    values = torch.ones(3, 5, device=native_device).t()
+    state = _rng_state(native_device)
+    with pytest.raises(ValueError, match="contiguous FP32"):
+        rounding.stochastic_round_bfloat16(values, backend="triton")
+    assert torch.equal(state, _rng_state(native_device))
