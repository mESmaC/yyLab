+        for gradient in gradients:
+            gradient.mul_(scale.to(gradient.dtype))
+        return
+
+    groups: dict[tuple[torch.device, torch.dtype], list[Tensor]] = {}
+    for gradient in gradients:
+        groups.setdefault((gradient.device, gradient.dtype), []).append(gradient)
+    for (_, dtype), values in groups.items():
+        typed_scale = scale.to(dtype)
+        if len(values) == 1:
+            values[0].mul_(typed_scale)
+        else:
+            foreach_mul(values, typed_scale)
+
+
