+"""CPU oracles and explicit SPALMER_TEST_CUDA=1 native compatibility checks."""
+
+import math
+import os
+import random
+import weakref
+from unittest.mock import patch
+
+import pytest
+
+from spalmer.experts.nvfp4_sm120 import (
+    e2m1_sr_reference,
+    nvfp4_sm120_compatibility,
+    pack_fp4_sr_reference,
+)
+
+LEVELS = (0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0)
+
+
+@pytest.mark.parametrize("sign", [1.0, -1.0])
+def test_exact_values_and_signed_zero(sign):
+    for code, value in enumerate(LEVELS):
+        for byte in range(256):
+            assert e2m1_sr_reference(sign * value, byte) == code | (8 if sign < 0 else 0)
+
+
+@pytest.mark.parametrize("sign", [1.0, -1.0])
+def test_neighbor_support_and_rounding_probability(sign):
+    for lower, upper in zip(LEVELS[:-1], LEVELS[1:], strict=True):
+        for fraction in (1 / 1024, 0.07, 0.25, 0.5, 0.73, 1023 / 1024):
+            value = lower + (upper - lower) * fraction
+            codes = [e2m1_sr_reference(sign * value, byte) & 7 for byte in range(256)]
+            rounded = [LEVELS[code] for code in codes]
+            assert set(rounded) <= {lower, upper}
+            actual_probability = rounded.count(upper) / 256
+            assert abs(actual_probability - fraction) <= 1 / 256
+
+
+def test_saturation_and_specials():
+    for byte in (0, 127, 128, 255):
+        assert e2m1_sr_reference(math.inf, byte) == 7
+        assert e2m1_sr_reference(-math.inf, byte) == 15
+        assert e2m1_sr_reference(100.0, byte) == 7
+        assert e2m1_sr_reference(-100.0, byte) == 15
+        assert e2m1_sr_reference(math.nan, byte) == 7
+        assert e2m1_sr_reference(-math.nan, byte) == 7
+
+
+def test_packed_lane_and_random_byte_mapping():
+    values = [0.75] * 8
+    low = pack_fp4_sr_reference(values, [0, 0, 0, 0])
+    assert low == [0x11] * 4
+    # A single high random byte must raise only its specific output nibble.
+    for word in (0, 1):
+        for byte in range(4):
+            words = [0] * 4
+            words[word] = 255 << (8 * byte)
+            output = pack_fp4_sr_reference(values, words)
+            nibble = 4 * word + (3 - byte)
+            expected = low.copy()
+            expected[nibble // 2] += 1 << (4 * (nibble % 2))
+            assert output == expected
+    assert pack_fp4_sr_reference(values, [0, 0, 0xFFFFFFFF, 0xFFFFFFFF]) == low
+
+
+def test_context_restores_on_exception_without_cuda_initialization():
+    import torch
+    initialized = torch.cuda.is_initialized()
+    # Instantiate JIT definitions with hardware-availability dependencies stubbed;
+    # this verifies context restoration without compiling or initializing CUDA.
+    with (
+        patch("torch.utils._triton.has_triton", return_value=True),
+        patch("torch.cuda.is_available", return_value=False),
+    ):
+        from torchao.prototype.moe_training.nvfp4_training import (
+            hadamard_quantize_row_col_triton as quantizer,
+        )
+        from torchao.prototype.moe_training.nvfp4_training import hadamard_utils
+
+        original = hadamard_utils.convert_8xfp32_to_4xfp4_packed_rs
+        previous_hash = hadamard_utils._pack_fp4.cache_key
+        previous_outer_hash = quantizer._hadamard_quantize_row_col_kernel.fn.cache_key
+        previous_cache = hadamard_utils._pack_fp4.device_caches
+        with pytest.raises(ValueError, match="intentional"):
+            with nvfp4_sm120_compatibility() as receipt:
+                assert hadamard_utils.convert_8xfp32_to_4xfp4_packed_rs is not original
+                assert hadamard_utils._pack_fp4.cache_key != previous_hash
+                assert (
+                    quantizer._hadamard_quantize_row_col_kernel.fn.cache_key != previous_outer_hash
+                )
+                with pytest.raises(RuntimeError, match="overlap"):
+                    with nvfp4_sm120_compatibility():
+                        pass
+                raise ValueError("intentional")
+    assert hadamard_utils.convert_8xfp32_to_4xfp4_packed_rs is original
+    assert hadamard_utils._pack_fp4.hash == previous_hash
+    assert quantizer._hadamard_quantize_row_col_kernel.fn.cache_key == previous_outer_hash
+    assert hadamard_utils._pack_fp4.device_caches is previous_cache
+    assert receipt["restored"] and receipt["package_sources_unchanged"]
+    assert torch.cuda.is_initialized() == initialized
+
+
+@pytest.mark.parametrize("initially_present", [False, True])
+def test_exception_releases_autotuner_input_and_restores_attribute(initially_present):
+    import torch
+
+    initialized = torch.cuda.is_initialized()
+    with (
+        patch("torch.utils._triton.has_triton", return_value=True),
+        patch("torch.cuda.is_available", return_value=False),
+    ):
+        from torchao.prototype.moe_training.nvfp4_training import (
+            hadamard_quantize_row_col_triton as quantizer,
+        )
+
+        tuner = quantizer._hadamard_quantize_row_col_kernel
+        missing = object()
+        prior_nargs = getattr(tuner, "nargs", missing)
+        expected = {"prior": object()} if initially_present else missing
+        if initially_present:
+            tuner.nargs = expected
+        elif hasattr(tuner, "nargs"):
+            delattr(tuner, "nargs")
+        try:
+            with pytest.raises(ValueError, match="simulated compile failure"):
+                with nvfp4_sm120_compatibility():
+                    tuner.nargs = {"input": torch.ones(16, device="cpu")}
+                    temporary_input = weakref.ref(tuner.nargs["input"])
+                    raise ValueError("simulated compile failure")
+            assert temporary_input() is None
+            assert getattr(tuner, "nargs", missing) is expected
+        finally:
+            if prior_nargs is missing:
+                if hasattr(tuner, "nargs"):
+                    delattr(tuner, "nargs")
+            else:
+                tuner.nargs = prior_nargs
+    assert torch.cuda.is_initialized() == initialized
+
